          "dataset",
          "anchor_pattern_id",
          "anchor_query",
          "matched_events",
          "anchors",
          "episode_gap_minutes",
          "window_minutes",
          "direction",
          "top_n",
          "excluded_patterns",
          "base_rate_grid",
          "by_direction",
        ],
        "type": "object",
      },
    ],
  },
}
