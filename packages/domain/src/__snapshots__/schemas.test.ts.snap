        "maximum": 9007199254740991,
        "type": "integer",
      },
      "sort": {
        "description": "relevance (default): BM25 score, highest first; time_asc / time_desc: by event time. Ties are broken by event_id.",
        "enum": [
          "relevance",
          "time_asc",
          "time_desc",
        ],
        "type": "string",
      },
      "total_matches": {
        "description": "Exact number of matching log events in scope, from the same condition as the hits.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer",
      },
      "truncated": {
        "description": "True when total_matches is larger than the number of hits.",
        "type": "boolean",
      },
