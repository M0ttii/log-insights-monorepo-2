                      "ratio": {
                        "anyOf": [
                          {
                            "minimum": 0,
                            "type": "number",
                          },
                          {
                            "type": "null",
                          },
                        ],
                        "description": "anchor_share / base_rate: how much more often the pattern occurs near anchors than in an arbitrary window. Null without a base rate or when it is 0.",
                      },
                      "team": {
                        "description": "Fictional owner team of the component; unowned if unmapped.",
                        "type": "string",
                      },
