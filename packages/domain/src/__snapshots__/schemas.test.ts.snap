            "properties": {
              "filters": {
                "additionalProperties": false,
                "description": "Filters applied besides dataset and window.",
                "properties": {
                  "alert_label": {
                    "description": "BGL only: dataset alert label (not our finding), e.g. KERNDTLB.",
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string",
                  },
                  "components": {
                    "description": "Only these components (exact names, 1–20). BGL: e.g. KERNEL; OpenStack: e.g. nova-compute.",
