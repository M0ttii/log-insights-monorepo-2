              "string",
              "null",
            ],
          },
          "anchor_query": {
            "description": "Anchor query as given; null for a pattern anchor.",
            "type": [
              "string",
              "null",
            ],
          },
          "anchors": {
            "description": "Episode starts among the matched events (gap ≥ 30 min, order ts, event_id); later events of an episode are no anchors.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
          "base_rate_grid": {
            "anyOf": [
              {
                "additionalProperties": false,
