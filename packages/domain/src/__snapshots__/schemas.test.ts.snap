exports[`JSON Schema export > checkClaimsInput converts losslessly for input and output 1`] = `
{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "claims": {
        "description": "1–30 claims: every number the answer states, each with the fact ID it cites.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "fact": {
              "description": "Fact ID exactly as listed in a tool result's facts, e.g. r_7f3a9c21.f4. Never build it yourself.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "group": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string",
                  },
                  {
                    "type": "number",
                  },
                  {
                    "type": "boolean",
                  },
                ],
              },
              "description": "Dimension values the text attributes the number to, e.g. {"dataset":"bgl","team":"Compute Platform"}; must equal the fact's group exactly (keys and values). Required: pass {} for ungrouped facts.",
              "propertyNames": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string",
              },
              "type": "object",
            },
            "metric": {
              "description": "Metric the text names, e.g. events or requests; must equal the fact's metric.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "unit": {
              "const": "percent",
              "description": "percent when a ratio is stated in percent (37.5 for 0.375); percent facts such as pct_change are stated as they are.",
              "type": "string",
            },
            "value": {
              "anyOf": [
                {
                  "type": "number",
                },
                {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              ],
              "description": "The value as stated: a number, or a string in the answer format with comma thousands separators and a dot decimal point ("4,747,963", "37.5"; "1.204" is a decimal); a time as ISO-8601 UTC prefix ("2005-06-03", "2005-06-03T15:42Z").",
            },
          },
          "required": [
            "fact",
            "value",
            "metric",
            "group",
          ],
          "type": "object",
        },
        "maxItems": 30,
        "minItems": 1,
        "type": "array",
      },
    },
    "required": [
      "claims",
    ],
    "type": "object",
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "claims": {
        "description": "1–30 claims: every number the answer states, each with the fact ID it cites.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "fact": {
              "description": "Fact ID exactly as listed in a tool result's facts, e.g. r_7f3a9c21.f4. Never build it yourself.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "group": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string",
                  },
                  {
                    "type": "number",
                  },
                  {
                    "type": "boolean",
                  },
                ],
              },
              "description": "Dimension values the text attributes the number to, e.g. {"dataset":"bgl","team":"Compute Platform"}; must equal the fact's group exactly (keys and values). Required: pass {} for ungrouped facts.",
              "propertyNames": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string",
              },
              "type": "object",
            },
            "metric": {
              "description": "Metric the text names, e.g. events or requests; must equal the fact's metric.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string",
            },
            "unit": {
              "const": "percent",
              "description": "percent when a ratio is stated in percent (37.5 for 0.375); percent facts such as pct_change are stated as they are.",
              "type": "string",
            },
            "value": {
              "anyOf": [
                {
                  "type": "number",
                },
                {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string",
                },
              ],
              "description": "The value as stated: a number, or a string in the answer format with comma thousands separators and a dot decimal point ("4,747,963", "37.5"; "1.204" is a decimal); a time as ISO-8601 UTC prefix ("2005-06-03", "2005-06-03T15:42Z").",
            },
          },
          "required": [
            "fact",
            "value",
            "metric",
            "group",
          ],
          "type": "object",
        },
        "maxItems": 30,
        "minItems": 1,
        "type": "array",
      },
    },
    "required": [
      "claims",
    ],
    "type": "object",
  },
}
`;

