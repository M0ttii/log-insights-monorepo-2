                          {
                            "minimum": 0,
                            "type": "number",
                          },
                          {
                            "type": "null",
                          },
                        ],
                        "description": "anchor_share / base_rate: how much more often the pattern occurs near anchors than in an arbitrary window. Null without a base rate or when it is 0.",
                      },
                      "team": {
                        "description": "Fictional owner team of the component; unowned if unmapped.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "pattern_id",
                      "pattern",
                      "pattern_truncated",
                      "component",
                      "team",
                      "anchors_with_pattern",
                      "anchor_share",
                      "base_rate_windows",
                      "base_rate",
                      "ratio",
                      "example_event_id",
                    ],
                    "type": "object",
                  },
                  "maxItems": 20,
                  "type": "array",
                },
                "patterns_found": {
                  "description": "Patterns with at least one anchor in this direction.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "truncated": {
                  "description": "True when patterns_found is larger than the list.",
                  "type": "boolean",
                },
                "window": {
                  "description": "The window per anchor, e.g. [anchor − 10 min, anchor).",
                  "type": "string",
                },
              },
              "required": [
                "direction",
                "window",
                "patterns_found",
                "truncated",
                "patterns",
              ],
              "type": "object",
            },
            "maxItems": 2,
            "minItems": 1,
            "type": "array",
          },
          "dataset": {
            "description": "Dataset: bgl (BlueGene/L, 2005–2006) or openstack (2017). They share no time axis.",
            "enum": [
              "bgl",
              "openstack",
            ],
            "type": "string",
          },
          "direction": {
            "description": "Direction used, after resolving the default.",
            "enum": [
              "before",
              "after",
              "both",
            ],
            "type": "string",
          },
          "episode_gap_minutes": {
            "description": "R-05 gap that starts a new episode, in minutes.",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer",
          },
          "excluded_patterns": {
            "description": "Patterns of the matched events; they are left out of every list.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
          "matched_events": {
            "description": "Log events in scope that match the anchor condition.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
          "mode": {
            "const": "aggregate",
            "description": "Mode of this result.",
            "type": "string",
          },
          "top_n": {
            "description": "Patterns listed at most per direction.",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer",
          },
          "window_minutes": {
            "description": "Window length w in minutes.",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer",
          },
        },
        "required": [
          "mode",
          "dataset",
          "anchor_pattern_id",
          "anchor_query",
          "matched_events",
          "anchors",
          "episode_gap_minutes",
          "window_minutes",
          "direction",
          "top_n",
          "excluded_patterns",
          "base_rate_grid",
          "by_direction",
        ],
        "type": "object",
      },
    ],
  },
}
`;

