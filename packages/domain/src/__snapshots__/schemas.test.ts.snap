              "required": [
                "direction",
                "limit",
                "in_window",
                "returned",
                "truncated",
              ],
              "type": "object",
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array",
          },
          "window_minutes": {
            "description": "Window length w in minutes on each side.",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer",
          },
        },
        "required": [
