# Copy this file to .env, fill in the password and (for Ask) your API key,
# then run: docker compose up
# Requires a recursive clone (the pinned vendor/serene-design submodule).
COMPOSE_FILE=compose.jury.yaml
COMPOSE_PROJECT_NAME=log-insights-jury

# Required. Choose a password (e.g. openssl rand -hex 16). Never commit .env.
# It seeds the database on FIRST start; changing it does not update a volume.
SERENEDB_PASSWORD=

# Optional for browsing; required for the live AI chat. Server-side only.
ANTHROPIC_API_KEY=
LOG_INSIGHTS_MODEL=claude-opus-5-5

# Official AMD64 release, pinned by registry digest. On Apple Silicon first
# restore the supplied ARM64 archive with docker image load --input ...,
# then replace this value with the immutable image ID below (not its tag):
# sha256:fd1b13533ceff354ffb48901dd63aa36a4b1d3c2b055b872e572bf83f38a7fb0
SERENEDB_IMAGE=serenedb/serenedb:26.10.1@sha256:6d41ac6577e797289158786a2015ba8fbd6875feadb5c491518e166c011058c9

# All other settings are optional. The web app is published on loopback only;
# SereneDB uses its private Compose hostname/port, never these host ports.
WEB_PORT=3000
SERENEDB_DATABASE=postgres
LOG_INSIGHTS_DATA_MODE=corpus
# Empty = full BGL + OpenStack; all = plus five full Loghub extensions.
# Or a comma-separated list: hdfs,openssh,apache,linux,zookeeper.
LOG_INSIGHTS_DATASETS=all
LOG_INSIGHTS_WORKSPACE_TOOLS=0

# Faster 2k smoke test: set LOG_INSIGHTS_DATA_MODE=samples and
# SERENEDB_DATABASE=log_insights_samples. With extensions (e.g. all), use
# SERENEDB_DATABASE=log_insights_samples_ext. These are samples, not the corpus.
