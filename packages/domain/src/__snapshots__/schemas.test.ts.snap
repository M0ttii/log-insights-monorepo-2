          "by_direction": {
            "description": "One entry per direction.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "direction": {
                  "description": "Window side relative to each anchor.",
                  "enum": [
                    "before",
                    "after",
                  ],
                  "type": "string",
                },
                "patterns": {
                  "description": "By anchors_with_pattern descending, then pattern_id.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "anchor_share": {
                        "description": "anchors_with_pattern / anchors.",
                        "maximum": 1,
                        "minimum": 0,
                        "type": "number",
                      },
