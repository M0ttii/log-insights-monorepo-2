# Copy to .env and fill in. Never commit .env.

# SereneDB (compose.yaml). The bootstrap superuser is "postgres" in the default
# database "postgres". SereneDB trusts it only from inside the container; host
# connections arrive through the Docker gateway and need this password, which
# seeds the role when the data volume is first created (technical.md § 5.1).
# Generate one, e.g. `openssl rand -hex 16`.
#
# SERENEDB_IMAGE has no default in compose.yaml; it must be one of the two
# verified 26.10.1 builds (technical.md § 5.1):
#   Apple Silicon / linux/arm64: the unofficial local build, restored with
#     `docker image load --input <archive>/docker-image.tar.gz`, never pulled
#     (the loader checks its image ID)
#   linux/amd64 (CI): serenedb/serenedb:26.10.1@sha256:6d41ac6577e797289158786a2015ba8fbd6875feadb5c491518e166c011058c9
SERENEDB_IMAGE=local/serenedb:26.10.1-arm64
SERENEDB_HOST=127.0.0.1
# Host port on 127.0.0.1; compose.yaml publishes the container's 7890 here.
SERENEDB_PORT=7890
SERENEDB_USER=postgres
SERENEDB_PASSWORD=
SERENEDB_DATABASE=postgres

# Optional: a second checkout (worktree) next to a running one needs its own
# Compose project, and with it its own data volume, plus its own
# SERENEDB_PORT. Without it the project is named after the directory.
COMPOSE_PROJECT_NAME=

# Web chat (apps/web, server-side only). Without a key the chat is disabled.
ANTHROPIC_API_KEY=
# Claude model for the web chat and the eval; the judges use Claude Opus 5.5.
LOG_INSIGHTS_MODEL=claude-opus-5-5

# Receipt directory; default <repository>/.data/receipts.
LOG_INSIGHTS_RECEIPTS_DIR=

# Set to 1 to register the optional index tools (concept A-33).
LOG_INSIGHTS_WORKSPACE_TOOLS=
