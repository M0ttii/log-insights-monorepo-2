  "sql": [
    "SELECT strftime(first_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS first, strftime(last_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS last FROM corpus_stats WHERE dataset = $1",
    "WITH comparison_bounds AS (SELECT $1::TIMESTAMPTZ AS cf, $2::TIMESTAMPTZ AS ct, $3::TIMESTAMPTZ AS bf, $4::TIMESTAMPTZ AS bt, $5::TIMESTAMPTZ AS first_ts, $6::TIMESTAMPTZ + INTERVAL '1 microsecond' AS end_ts), comparison_coverage AS (SELECT CASE WHEN ct <= first_ts OR cf >= end_ts THEN 'none' WHEN cf >= first_ts AND ct <= end_ts THEN 'full' ELSE 'partial' END AS current, CASE WHEN bt <= first_ts OR bf >= end_ts THEN 'none' WHEN bf >= first_ts AND bt <= end_ts THEN 'full' ELSE 'partial' END AS baseline FROM comparison_bounds) SELECT current, baseline, current <> 'none' AND baseline <> 'none' AS determinable FROM comparison_coverage",
    "SELECT rules_version, pattern_rules_version FROM load_manifest",
    "WITH cur AS (SELECT e.event_id, e.pattern_id, e.pattern, e.dataset, e.component, e.ts, e.node AS u1, e.rack AS u2 FROM log_events e WHERE e.dataset = $1 AND coalesce((SELECT o.team FROM ownership o WHERE o.dataset = e.dataset AND o.component = e.component), 'unowned') IN ($2) AND e.ts >= $4::TIMESTAMPTZ AND e.ts < $5::TIMESTAMPTZ), episodic AS (SELECT * FROM cur MATCH_RECOGNIZE (PARTITION BY pattern_id ORDER BY ts, event_id MEASURES pattern AS pattern, dataset AS dataset, component AS component, u1 AS u1, u2 AS u2, CLASSIFIER() AS phase, MATCH_NUMBER() AS episode ALL ROWS PER MATCH AFTER MATCH SKIP PAST LAST ROW PATTERN (s n*) DEFINE n AS ts - PREV(ts) < $3::INTERVAL)), c AS (SELECT pattern_id, min(pattern) AS pattern, min(dataset) AS dataset, min(component) AS component, count(*) AS events, count(*) FILTER (WHERE phase = 's') AS episodes, count(DISTINCT date_trunc('day', ts)) AS active_days, count(DISTINCT date_trunc('week', ts)) AS active_weeks, CASE WHEN count(u1) = count(*) THEN count(DISTINCT u1) END AS b1, CASE WHEN count(u2) = count(*) THEN count(DISTINCT u2) END AS b2, count(DISTINCT component) AS components, min(ts) AS first_ts, max(ts) AS last_ts, min(event_id) FILTER (WHERE phase = 's' AND episode = 1) AS example_event_id FROM episodic GROUP BY pattern_id), joined AS (SELECT *, NULL::BIGINT AS baseline, NULL::BIGINT AS delta FROM c), history AS (SELECT e.pattern_id, min(e.ts) AS first_before FROM log_events e WHERE e.dataset = $1 AND coalesce((SELECT o.team FROM ownership o WHERE o.dataset = e.dataset AND o.component = e.component), 'unowned') IN ($2) AND e.ts < $9::TIMESTAMPTZ AND $10::TIMESTAMPTZ < $9::TIMESTAMPTZ AND e.pattern_id IN (SELECT pattern_id FROM joined) GROUP BY e.pattern_id), ruled AS (SELECT joined.*, history.first_before, episodes >= $6::BIGINT AS recurring, CASE WHEN events > 0 AND history.first_before IS NULL AND $10::TIMESTAMPTZ < $9::TIMESTAMPTZ THEN 'new' WHEN baseline > 0 AND events >= $7::BIGINT * baseline AND events - baseline >= $8::BIGINT THEN 'escalating' WHEN baseline = 0 AND events > 0 AND history.first_before IS NOT NULL THEN 'reappeared' WHEN events > 0 THEN 'ongoing' WHEN baseline > 0 THEN 'quiet' ELSE NULL::VARCHAR END AS status FROM joined LEFT JOIN history ON joined.pattern_id = history.pattern_id), totals AS (SELECT coalesce(sum(events), 0)::BIGINT AS total, coalesce(count_if(events > 0), 0) AS active, coalesce(count_if(events = 0), 0) AS quiet FROM joined) , ranked AS (SELECT *, row_number() OVER (ORDER BY episodes DESC, events DESC, pattern_id ASC) AS rank FROM ruled) SELECT * FROM (SELECT 'pattern' AS record_kind, pattern_id AS pattern_id, pattern AS pattern, dataset AS dataset, component AS component, coalesce((SELECT o.team FROM ownership o WHERE o.dataset = ranked.dataset AND o.component = ranked.component), 'unowned') AS team, events AS events, episodes AS episodes, active_days AS active_days, active_weeks AS active_weeks, b1 AS b1, b2 AS b2, components AS components, example_event_id AS example_event_id, baseline AS baseline, delta AS delta, recurring AS recurring, status AS status, strftime(first_before, '%Y-%m-%dT%H:%M:%S.%fZ') AS first_seen_before_window, strftime(first_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS first_seen, strftime(last_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS last_seen, events::DOUBLE / NULLIF((SELECT total FROM totals), 0) AS share, (SELECT total FROM totals) AS total, (SELECT active FROM totals) AS active, (SELECT quiet FROM totals) AS quiet, NULL::BIGINT AS candidates_checked, NULL::BIGINT AS missing_breadth, NULL::BOOLEAN AS drop_breadth, NULL::BOOLEAN AS drop_increase, NULL::BIGINT AS not_dominated_by_first, NULL::VARCHAR AS first_pattern_id, NULL::BIGINT AS compared_with, NULL::BOOLEAN AS truncated, NULL::BIGINT AS qualifying, NULL::VARCHAR AS criterion, NULL::BIGINT AS value, NULL::BIGINT AS tied, NULL::VARCHAR AS a, NULL::VARCHAR AS b, NULL::BOOLEAN AS a_episodes, NULL::BOOLEAN AS a_breadth, NULL::BOOLEAN AS a_change, NULL::BOOLEAN AS b_episodes, NULL::BOOLEAN AS b_breadth, NULL::BOOLEAN AS b_change, NULL::BOOLEAN AS b_listed, NULL::BIGINT AS sort_section, rank AS sort_a, NULL::BIGINT AS sort_b FROM ranked WHERE rank <= $11::BIGINT UNION ALL SELECT 'summary' AS record_kind, NULL::VARCHAR AS pattern_id, NULL::VARCHAR AS pattern, NULL::VARCHAR AS dataset, NULL::VARCHAR AS component, NULL::VARCHAR AS team, NULL::BIGINT AS events, NULL::BIGINT AS episodes, NULL::BIGINT AS active_days, NULL::BIGINT AS active_weeks, NULL::BIGINT AS b1, NULL::BIGINT AS b2, NULL::BIGINT AS components, NULL::BIGINT AS example_event_id, NULL::BIGINT AS baseline, NULL::BIGINT AS delta, NULL::BOOLEAN AS recurring, NULL::VARCHAR AS status, NULL::VARCHAR AS first_seen_before_window, NULL::VARCHAR AS first_seen, NULL::VARCHAR AS last_seen, NULL::DOUBLE AS share, total AS total, active AS active, quiet AS quiet, NULL::BIGINT AS candidates_checked, NULL::BIGINT AS missing_breadth, NULL::BOOLEAN AS drop_breadth, NULL::BOOLEAN AS drop_increase, NULL::BIGINT AS not_dominated_by_first, NULL::VARCHAR AS first_pattern_id, NULL::BIGINT AS compared_with, active + quiet > $11::BIGINT AS truncated, active + quiet AS qualifying, NULL::VARCHAR AS criterion, NULL::BIGINT AS value, NULL::BIGINT AS tied, NULL::VARCHAR AS a, NULL::VARCHAR AS b, NULL::BOOLEAN AS a_episodes, NULL::BOOLEAN AS a_breadth, NULL::BOOLEAN AS a_change, NULL::BOOLEAN AS b_episodes, NULL::BOOLEAN AS b_breadth, NULL::BOOLEAN AS b_change, NULL::BOOLEAN AS b_listed, NULL::BIGINT AS sort_section, NULL::BIGINT AS sort_a, NULL::BIGINT AS sort_b FROM totals) records ORDER BY record_kind, sort_section, sort_a, sort_b, criterion, pattern_id, a, b"
  ],
