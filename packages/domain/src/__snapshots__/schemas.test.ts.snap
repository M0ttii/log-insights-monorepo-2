exports[`JSON Schema export > eventTrendInput converts losslessly for input and output 1`] = `
{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "alert_label": {
        "description": "BGL only: dataset alert label (not our finding), e.g. KERNDTLB.",
        "maxLength": 32,
        "minLength": 1,
        "type": "string",
      },
      "bucket": {
        "description": "Bucket size in UTC: hour, day or week (weeks start on Monday 00:00 UTC). Each bucket is [start, start + 1 unit).",
        "enum": [
          "hour",
          "day",
          "week",
        ],
        "type": "string",
      },
      "components": {
        "description": "Only these components (exact names, 1–20). BGL: e.g. KERNEL; OpenStack: e.g. nova-compute.",
        "items": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array",
      },
      "dataset": {
        "description": "Required, exactly one dataset: bgl (BlueGene/L, 2005–2006) or openstack (2017). They share no time axis, so a trend is always per dataset; call twice to see both.",
        "enum": [
          "bgl",
          "openstack",
        ],
        "type": "string",
      },
      "from": {
        "description": "Window start, inclusive. ISO-8601 with Z or ±HH:MM and at most 6 fractional digits, e.g. 2005-06-03T00:00:00Z. Default: start of the data span.",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string",
      },
      "levels": {
        "description": "Only these levels (1–10).",
        "items": {
          "description": "Level as stored, upper case, e.g. INFO, WARNING, ERROR, FATAL.",
          "pattern": "^[A-Z][A-Z_]{0,15}$",
          "type": "string",
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array",
      },
      "node": {
        "description": "BGL only: exact node ID, e.g. R02-M1-N0-C:J12-U11.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "only_alerts": {
        "description": "BGL only: only lines with an alert label other than '-'. Default: false.",
        "type": "boolean",
      },
      "only_errors": {
        "description": "Only error events (R-02 levels per dataset). Default: false.",
        "type": "boolean",
      },
      "pattern_id": {
        "description": "Exact pattern ID as returned by recurring_patterns (lower-case hex).",
        "pattern": "^[0-9a-f]{8,64}$",
        "type": "string",
      },
      "rack": {
        "description": "BGL only: rack, e.g. R02.",
        "maxLength": 16,
        "minLength": 1,
        "type": "string",
      },
      "split_by": {
        "description": "Optional, one dimension: the 5 values with the most events in scope become series (ties by value), all others are summed as other. Without split_by only the bucket totals are returned.",
        "enum": [
          "team",
          "component",
