{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "CI",
    "PORT",
    "COMPOSE_PROJECT_NAME",
    "SERENEDB_IMAGE",
    "SERENEDB_HOST",
    "SERENEDB_PORT",
    "SERENEDB_USER",
    "SERENEDB_PASSWORD",
    "SERENEDB_DATABASE",
    "SERENEDB_OTLP_PORT",
    "SERENEDB_OTLP_SAMPLES_PORT",
    "LOG_INSIGHTS_RECEIPTS_DIR",
    "LOG_INSIGHTS_WORKSPACE_TOOLS",
    "ANTHROPIC_API_KEY",
    "LOG_INSIGHTS_MODEL",
    "LOG_INSIGHTS_RUNS_DIR",
    "LOG_INSIGHTS_RETRIEVAL_DIR",
    "LOG_INSIGHTS_EMBEDDING_SECRET"
  ]
}
