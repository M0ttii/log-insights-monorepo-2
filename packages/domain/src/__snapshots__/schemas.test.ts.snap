                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "maxItems": 20,
                    "minItems": 1,
                    "type": "array",
                  },
                  "instance_id": {
                    "description": "OpenStack only: exact instance UUID.",
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string",
                  },
                  "levels": {
                    "description": "Only these levels (1–10).",
                    "items": {
                      "description": "Level as stored, upper case, e.g. INFO, WARNING, ERROR, FATAL.",
                      "pattern": "^[A-Z][A-Z_]{0,15}$",
                      "type": "string",
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "type": "array",
                  },
                  "node": {
                    "description": "BGL only: exact node ID, e.g. R02-M1-N0-C:J12-U11.",
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string",
                  },
                  "only_alerts": {
                    "description": "BGL only: only lines with an alert label other than '-'. Default: false.",
                    "type": "boolean",
                  },
                  "only_errors": {
                    "description": "Only error events (R-02 levels per dataset). Default: false.",
                    "type": "boolean",
                  },
                  "pattern_id": {
                    "description": "Exact pattern ID as returned by recurring_patterns (lower-case hex).",
                    "pattern": "^[0-9a-f]{8,64}$",
                    "type": "string",
                  },
                  "rack": {
                    "description": "BGL only: rack, e.g. R02.",
                    "maxLength": 16,
                    "minLength": 1,
                    "type": "string",
                  },
                  "request_id": {
                    "description": "OpenStack only: exact request ID, e.g. req-<uuid>.",
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string",
                  },
                  "teams": {
                    "description": "Only components owned by these teams (fictional ownership table, 1–10); unmapped components are 'unowned'.",
                    "items": {
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "type": "array",
                  },
                  "text": {
                    "description": "Full-text condition on the message, all terms must match (1–200 characters).",
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "type": "object",
              },
              "windows": {
                "description": "One window per dataset (BGL and OpenStack share no time axis), or the two periods of a comparison within one dataset.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "dataset": {
                      "description": "Dataset: bgl (BlueGene/L, 2005–2006) or openstack (2017). They share no time axis.",
                      "enum": [
                        "bgl",
                        "openstack",
                      ],
                      "type": "string",
                    },
                    "from": {
                      "description": "Resolved window start, inclusive.",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                      "type": "string",
                    },
                    "period": {
                      "description": "Only in period comparisons: current period C or reference period B.",
                      "enum": [
                        "current",
                        "baseline",
                      ],
                      "type": "string",
                    },
                    "to": {
                      "description": "Resolved window end, exclusive.",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                      "type": "string",
                    },
                  },
                  "required": [
                    "dataset",
                    "from",
                    "to",
                  ],
                  "type": "object",
                },
                "maxItems": 2,
                "minItems": 1,
                "type": "array",
              },
            },
            "required": [
