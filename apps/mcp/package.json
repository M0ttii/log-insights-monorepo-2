{
  "name": "@workspace/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "desktop-config": "node --import tsx src/print-desktop-config.ts",
    "test:smoke": "vitest run --config ../../vitest.config.ts --project mcp-smoke --no-file-parallelism",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@workspace/analytics": "workspace:*",
    "@workspace/domain": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
