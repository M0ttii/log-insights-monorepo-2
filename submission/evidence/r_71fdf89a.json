  "sql": [
    "SELECT strftime(first_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS first, strftime(last_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS last FROM corpus_stats WHERE dataset = $1",
    "WITH grid AS (SELECT unnest(range(date_trunc('hour', $4::TIMESTAMPTZ), $5::TIMESTAMPTZ, $6::INTERVAL)) AS bucket), captured AS (SELECT date_trunc('hour', log_events.ts) AS bucket FROM log_events WHERE log_events.dataset = $1 AND log_events.ts >= $2::TIMESTAMPTZ AND log_events.ts < $3::TIMESTAMPTZ GROUP BY 1) SELECT strftime(g.bucket, '%Y-%m-%dT%H:%M:%S.%fZ') AS bucket, strftime(g.bucket + $7::INTERVAL, '%Y-%m-%dT%H:%M:%S.%fZ') AS bucket_end, g.bucket < $8::TIMESTAMPTZ OR g.bucket + $9::INTERVAL > $10::TIMESTAMPTZ AS partial, c.bucket IS NULL AS capture_gap FROM grid g LEFT JOIN captured c ON g.bucket = c.bucket ORDER BY g.bucket",
    "WITH grid AS (SELECT unnest(range(date_trunc('hour', $5::TIMESTAMPTZ), $6::TIMESTAMPTZ, $7::INTERVAL)) AS bucket), counted AS (SELECT date_trunc('hour', log_events.ts) AS bucket, count(*) AS events FROM log_events WHERE log_events.dataset = $1 AND log_events.ts >= $2::TIMESTAMPTZ AND log_events.ts < $3::TIMESTAMPTZ AND log_events.pattern_id = $4 GROUP BY 1) SELECT strftime(g.bucket, '%Y-%m-%dT%H:%M:%S.%fZ') AS bucket, coalesce(c.events, 0)::BIGINT AS events, sum(coalesce(c.events, 0)) OVER ()::BIGINT AS total FROM grid g LEFT JOIN counted c ON g.bucket = c.bucket ORDER BY g.bucket"
  ],
