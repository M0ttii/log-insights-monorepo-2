  "sql": [
    "SELECT strftime(first_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS first, strftime(last_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS last FROM corpus_stats WHERE dataset = $1",
    "WITH grid AS (SELECT unnest(range(date_trunc('week', $4::TIMESTAMPTZ), $5::TIMESTAMPTZ, $6::INTERVAL)) AS bucket), captured AS (SELECT date_trunc('week', log_events.ts) AS bucket FROM log_events WHERE log_events.dataset = $1 AND log_events.ts >= $2::TIMESTAMPTZ AND log_events.ts < $3::TIMESTAMPTZ GROUP BY 1) SELECT strftime(g.bucket, '%Y-%m-%dT%H:%M:%S.%fZ') AS bucket, strftime(g.bucket + $7::INTERVAL, '%Y-%m-%dT%H:%M:%S.%fZ') AS bucket_end, g.bucket < $8::TIMESTAMPTZ OR g.bucket + $9::INTERVAL > $10::TIMESTAMPTZ AS partial, c.bucket IS NULL AS capture_gap FROM grid g LEFT JOIN captured c ON g.bucket = c.bucket ORDER BY g.bucket",
    "WITH grid AS (SELECT unnest(range(date_trunc('week', $5::TIMESTAMPTZ), $6::TIMESTAMPTZ, $7::INTERVAL)) AS bucket), cells AS (SELECT date_trunc('week', log_events.ts) AS bucket, log_events.pattern_id AS value, count(*) AS events FROM log_events WHERE log_events.dataset = $1 AND log_events.ts >= $2::TIMESTAMPTZ AND log_events.ts < $3::TIMESTAMPTZ AND coalesce((SELECT o.team FROM ownership o WHERE o.dataset = log_events.dataset AND o.component = log_events.component), 'unowned') IN ($4) GROUP BY 1, 2), ranked AS (SELECT bucket, value, events, dense_rank() OVER (ORDER BY value_events DESC, value ASC NULLS LAST) AS series_rank FROM (SELECT bucket, value, events, sum(events) OVER (PARTITION BY value) AS value_events FROM cells) t), slots AS (SELECT bucket, least(series_rank, 6) AS slot, CASE WHEN series_rank <= 5 THEN value END AS value, series_rank, events FROM ranked) SELECT slot, value, sum(events) AS events, count(DISTINCT series_rank) AS merged_values, sum(sum(events)) OVER () AS total FROM slots GROUP BY slot, value ORDER BY slot",
    "WITH grid AS (SELECT unnest(range(date_trunc('week', $5::TIMESTAMPTZ), $6::TIMESTAMPTZ, $7::INTERVAL)) AS bucket), cells AS (SELECT date_trunc('week', log_events.ts) AS bucket, log_events.pattern_id AS value, count(*) AS events FROM log_events WHERE log_events.dataset = $1 AND log_events.ts >= $2::TIMESTAMPTZ AND log_events.ts < $3::TIMESTAMPTZ AND coalesce((SELECT o.team FROM ownership o WHERE o.dataset = log_events.dataset AND o.component = log_events.component), 'unowned') IN ($4) GROUP BY 1, 2), ranked AS (SELECT bucket, value, events, dense_rank() OVER (ORDER BY value_events DESC, value ASC NULLS LAST) AS series_rank FROM (SELECT bucket, value, events, sum(events) OVER (PARTITION BY value) AS value_events FROM cells) t), slots AS (SELECT bucket, least(series_rank, 6) AS slot, CASE WHEN series_rank <= 5 THEN value END AS value, series_rank, events FROM ranked), slot_totals AS (SELECT bucket, slot, sum(events) AS events FROM slots GROUP BY bucket, slot), named_slots AS (SELECT DISTINCT slot FROM slots), completed AS (SELECT g.bucket, n.slot, coalesce(c.events, 0)::BIGINT AS events FROM grid g LEFT JOIN named_slots n ON TRUE LEFT JOIN slot_totals c ON c.bucket = g.bucket AND c.slot = n.slot) SELECT strftime(bucket, '%Y-%m-%dT%H:%M:%S.%fZ') AS bucket, slot, events, sum(events) OVER (PARTITION BY bucket)::BIGINT AS bucket_events FROM completed ORDER BY bucket, slot"
  ],
