  "sql": [
    "SELECT strftime(first_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS first, strftime(last_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS last FROM corpus_stats WHERE dataset = $1",
    "WITH base AS (SELECT NULL AS g, log_events.request_id, log_events.latency_ms, log_events.http_status FROM log_events WHERE log_events.ts >= $1::TIMESTAMPTZ AND log_events.ts < $2::TIMESTAMPTZ AND log_events.dataset = 'openstack' AND log_events.http_status IS NOT NULL), agg AS (SELECT 0::BIGINT AS slot, NULL::VARCHAR AS g, 0::BIGINT AS groups, count(*) AS api_access_events, count(*) FILTER (WHERE request_id IS NULL) AS without_request_id, count(DISTINCT request_id) AS unique_requests, count(latency_ms) AS latency_values, quantile_cont(latency_ms, [0.5, 0.9, 0.95, 0.99]) AS q, max(latency_ms) AS max_ms, count(*) FILTER (WHERE http_status BETWEEN 500 AND 599) AS errors_5xx, count(*) FILTER (WHERE http_status BETWEEN 400 AND 499) AS errors_4xx FROM base) SELECT slot, g AS g, groups, api_access_events, without_request_id, unique_requests, latency_values, q[1] AS p50_ms, q[2] AS p90_ms, q[3] AS p95_ms, q[4] AS p99_ms, max_ms, errors_5xx, errors_5xx::DOUBLE / NULLIF(api_access_events, 0) AS rate_5xx, errors_4xx, errors_4xx::DOUBLE / NULLIF(api_access_events, 0) AS rate_4xx FROM agg"
  ],
