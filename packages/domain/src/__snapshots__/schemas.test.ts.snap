{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "data_span": {
        "additionalProperties": false,
        "description": "Observed span of the dataset, before any filter.",
        "properties": {
          "first": {
            "description": "First OpenStack event, UTC.",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string",
          },
          "last": {
            "description": "Last OpenStack event, UTC.",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string",
          },
        },
        "required": [
          "first",
          "last",
        ],
        "type": "object",
      },
      "dataset": {
        "const": "openstack",
        "type": "string",
      },
      "effective_range": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "from": {
                "description": "Start, inclusive.",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string",
              },
              "to": {
                "description": "End, exclusive.",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string",
              },
            },
            "required": [
              "from",
              "to",
            ],
            "type": "object",
          },
          {
            "type": "null",
          },
        ],
        "description": "Window ∩ data span: the time the numbers cover; null when the window lies outside the data span (no data is not zero).",
      },
      "group_by": {
        "anyOf": [
          {
            "description": "Grouping: endpoint (API path with IDs masked), method (HTTP method), status (HTTP status code), component (logging service), hour or day (UTC buckets [start, start + 1 unit), listed in time order).",
            "enum": [
              "endpoint",
              "method",
              "status",
              "component",
              "hour",
              "day",
            ],
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
      },
      "group_count": {
        "description": "Number of groups in scope (with hour or day: buckets listed); 0 without group_by.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer",
      },
      "groups": {
        "description": "endpoint, method, status, component: at most top_n groups by api_access_events descending, then key ascending. hour, day: every bucket of the effective range in time order, empty buckets included.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "api_access_events": {
              "description": "API accesses: OpenStack lines with an HTTP status, with or without request ID (R-01). Denominator of rate_5xx and rate_4xx.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
