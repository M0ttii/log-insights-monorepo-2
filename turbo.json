{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "CI",
    "PORT",
    "SERENEDB_HOST",
    "SERENEDB_PORT",
    "SERENEDB_USER",
    "SERENEDB_PASSWORD",
    "SERENEDB_DATABASE",
    "LOG_INSIGHTS_RECEIPTS_DIR",
    "LOG_INSIGHTS_WORKSPACE_TOOLS"
  ]
}
