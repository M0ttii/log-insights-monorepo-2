exports[`JSON Schema export > factSpec converts losslessly for input and output 1`] = `
{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "groupKeys": {
        "description": "Dimension fields of the surrounding row that identify the group, e.g. [dataset, team].",
        "items": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
        },
        "type": "array",
      },
      "metric": {
        "description": "What the number measures, e.g. events, share, p95_latency.",
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string",
      },
      "path": {
        "description": "Pointer from the receipt root; * matches every array element, e.g. /result/groups/*/events.",
        "pattern": "^\\/(result|scope)(\\/([A-Za-z0-9_]+|\\*))+$",
        "type": "string",
      },
      "unit": {
        "description": "Unit, counting units after R-01: log_events, api_accesses, requests.",
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string",
      },
    },
    "required": [
      "path",
      "metric",
      "unit",
      "groupKeys",
    ],
    "type": "object",
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "groupKeys": {
        "description": "Dimension fields of the surrounding row that identify the group, e.g. [dataset, team].",
        "items": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
        },
        "type": "array",
      },
      "metric": {
        "description": "What the number measures, e.g. events, share, p95_latency.",
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string",
      },
      "path": {
        "description": "Pointer from the receipt root; * matches every array element, e.g. /result/groups/*/events.",
        "pattern": "^\\/(result|scope)(\\/([A-Za-z0-9_]+|\\*))+$",
        "type": "string",
      },
      "unit": {
        "description": "Unit, counting units after R-01: log_events, api_accesses, requests.",
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string",
      },
    },
    "required": [
      "path",
      "metric",
      "unit",
      "groupKeys",
    ],
    "type": "object",
  },
}
`;

exports[`JSON Schema export > filter converts losslessly for input and output 1`] = `
{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "alert_label": {
        "description": "BGL only: dataset alert label (not our finding), e.g. KERNDTLB.",
        "maxLength": 32,
        "minLength": 1,
        "type": "string",
      },
      "block_id": {
        "description": "HDFS only: exact block ID, e.g. blk_-1608999687919862906.",
        "pattern": "^blk_-?\\d{1,20}$",
        "type": "string",
      },
      "client_ip": {
        "description": "OpenSSH and Apache only: exact IPv4 address of the remote side, e.g. 173.234.31.186.",
        "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}$",
        "type": "string",
      },
      "components": {
        "description": "Only these components (exact names, 1–20). BGL: e.g. KERNEL; OpenStack: e.g. nova-compute; otel: the service, e.g. cart.",
        "items": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array",
      },
      "dataset": {
        "description": "Dataset: bgl (BGL), openstack (OpenStack), hdfs (HDFS_v1), openssh (OpenSSH), apache (Apache), linux (Linux), zookeeper (ZooKeeper), otel (OpenTelemetry logs (text_bench)), otel_replay (OpenTelemetry OTLP replay (text_bench sample)). No two datasets share a time axis; describe_corpus lists the loaded ones. otel and otel_replay are not in log_events and only queried when named here: otel is read in place from remote Parquet files (full text only inside its indexed reference window; counts or trends without text need from/to at most 60 s apart), otel_replay is a bounded OTLP replay of public records into SereneDB's OTel tables.",
        "enum": [
          "bgl",
          "openstack",
          "hdfs",
          "openssh",
          "apache",
          "linux",
          "zookeeper",
          "otel",
          "otel_replay",
        ],
        "type": "string",
      },
      "endpoints": {
        "description": "OpenStack only: only API accesses to these endpoints (1–20), exactly as returned with IDs masked, e.g. /v2/<ID>/servers/detail.",
        "items": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array",
      },
      "from": {
        "description": "Window start, inclusive. ISO-8601 with Z or ±HH:MM and at most 6 fractional digits, e.g. 2005-06-03T00:00:00Z. Default: start of the data span.",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string",
      },
      "host": {
        "description": "OpenSSH and Linux only: exact syslog host, e.g. LabSZ, combo.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "http_status": {
        "additionalProperties": false,
        "description": "OpenStack only: only API accesses whose HTTP status lies in [min, max], both inclusive, e.g. {min: 500, max: 599} for 5xx or {min: 400, max: 499} for 4xx.",
        "properties": {
          "max": {
            "description": "Highest status, inclusive.",
            "maximum": 599,
            "minimum": 100,
            "type": "integer",
          },
          "min": {
            "description": "Lowest status, inclusive.",
            "maximum": 599,
            "minimum": 100,
