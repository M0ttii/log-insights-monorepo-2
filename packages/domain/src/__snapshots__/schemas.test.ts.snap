                      },
                      {
                        "type": "null",
                      },
                    ],
                  },
                  "episodes": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "pattern_ids": {
                            "description": "Up to 5 of them in the investigation order (R-08).",
                            "items": {
                              "type": "string",
                            },
                            "maxItems": 5,
                            "minItems": 1,
                            "type": "array",
                          },
                          "tied": {
                            "description": "Candidates that share the highest value.",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "type": "integer",
                          },
                          "value": {
                            "description": "Highest value of this criterion among all candidates checked.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                        },
                        "required": [
                          "value",
                          "tied",
                          "pattern_ids",
                        ],
                        "type": "object",
                      },
                      {
                        "type": "null",
                      },
                    ],
                  },
                  "events": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "pattern_ids": {
                            "description": "Up to 5 of them in the investigation order (R-08).",
                            "items": {
                              "type": "string",
                            },
                            "maxItems": 5,
                            "minItems": 1,
                            "type": "array",
                          },
                          "tied": {
                            "description": "Candidates that share the highest value.",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "type": "integer",
                          },
                          "value": {
                            "description": "Highest value of this criterion among all candidates checked.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                        },
                        "required": [
                          "value",
                          "tied",
                          "pattern_ids",
                        ],
                        "type": "object",
                      },
                      {
                        "type": "null",
                      },
                    ],
                  },
                  "increase": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "pattern_ids": {
                            "description": "Up to 5 of them in the investigation order (R-08).",
                            "items": {
                              "type": "string",
                            },
                            "maxItems": 5,
                            "minItems": 1,
                            "type": "array",
                          },
                          "tied": {
                            "description": "Candidates that share the highest value.",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "type": "integer",
                          },
                          "value": {
                            "description": "Highest value of this criterion among all candidates checked.",
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer",
                          },
                        },
                        "required": [
                          "value",
                          "tied",
                          "pattern_ids",
                        ],
                        "type": "object",
                      },
                      {
                        "type": "null",
                      },
                    ],
                  },
                },
                "required": [
                  "episodes",
                  "breadth",
                  "increase",
                  "events",
                ],
                "type": "object",
              },
              "limits": {
                "const": "Technical investigation order (R-08), not a measure of severity or business risk: a rare severe problem can rank lower. Levels, labels and status are shown separately. Business impact unknown.",
                "description": "R-09 limit; quote it.",
                "type": "string",
              },
              "rank_basis": {
                "additionalProperties": false,
                "description": "What the order is based on.",
                "properties": {
                  "criteria": {
                    "description": "Criteria applied, in this order (R-08).",
                    "items": {
                      "enum": [
                        "episodes",
                        "breadth",
                        "increase",
                        "events",
                        "pattern_id",
                      ],
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "dropped": {
                    "description": "Criteria not determinable for every candidate, left out of the whole ranking, with the reason.",
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "criterion": {
                          "enum": [
                            "episodes",
                            "breadth",
                            "increase",
                            "events",
                            "pattern_id",
                          ],
                          "type": "string",
                        },
                        "reason": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "criterion",
                        "reason",
                      ],
                      "type": "object",
                    },
                    "type": "array",
                  },
                },
                "required": [
                  "criteria",
                  "dropped",
                ],
                "type": "object",
              },
            },
            "required": [
              "candidates_checked",
              "rank_basis",
              "leaders",
              "dominance",
              "limits",
            ],
            "type": "object",
          },
          {
            "type": "null",
          },
        ],
      },
      "limit": {
        "description": "The limit that applied.",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer",
      },
      "pattern_count": {
        "description": "Patterns with events in the window (with investigation_order: candidates).",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer",
      },
      "patterns": {
        "description": "At most limit patterns in rank order, ties by pattern_id.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "active_days": {
              "description": "Distinct UTC days with an event in the window.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "active_weeks": {
              "description": "Distinct UTC weeks (Monday start) with an event in the window.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "baseline": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "B: events in the previous period of the same length with the same filters; null when that period lies outside the data span.",
            },
            "blocks": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "HDFS breadth (R-08). Distinct blocks of the pattern's events in the window; null when not every event carries one (no lower bound from partly set values, R-08). Absent for other datasets.",
            },
            "client_ips": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "OpenSSH and Apache breadth (R-08). Distinct client IPs of the pattern's events in the window; null when not every event carries one (no lower bound from partly set values, R-08). Absent for other datasets.",
            },
            "component": {
              "description": "Component or OpenStack service.",
              "type": [
                "string",
                "null",
              ],
            },
            "components": {
              "description": "Distinct components; a pattern belongs to one component (R-04), so 1 when it has events in the window.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "delta": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "C − B, computed in SereneDB; null when B is not determinable.",
            },
            "episodes": {
              "description": "Episodes in the window (R-05): a new one starts after at least 30 minutes without an event of the pattern in the filtered scope. Not outages.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "events": {
              "description": "C: log events of the pattern in [from, to).",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "example_event_id": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "First event of the pattern in the window; pass it to get_log_context. null without events in the window.",
            },
            "first_seen": {
              "anyOf": [
                {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "First event in the window, UTC; null without events in it.",
            },
            "first_seen_before_window": {
              "anyOf": [
                {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "First event of the pattern before from with the same filters except time (back to the start of the dataset); null when there is none or the window starts with the data.",
            },
            "instances": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "OpenStack breadth (R-08). Distinct instances of the pattern's events in the window; null when not every event carries one (no lower bound from partly set values, R-08). Absent for other datasets.",
            },
            "labels": {
              "anyOf": [
                {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "alert_label": {
                        "description": "BGL dataset alert label, not our finding.",
                        "type": "string",
                      },
                      "events": {
                        "description": "Events of the pattern in scope with this label.",
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer",
                      },
                    },
                    "required": [
                      "alert_label",
                      "events",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                {
                  "type": "null",
                },
              ],
              "description": "Only with investigation_order: events per BGL alert label, most first; null for OpenStack, whose anomaly labels mark instances, not lines. No ranking criterion (R-09).",
            },
            "last_seen": {
              "anyOf": [
                {
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "Last event in the window, UTC; null without events in it.",
            },
            "levels": {
              "description": "Only with investigation_order: events per level, most first. A level is no ranking criterion (R-09).",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "events": {
                    "description": "Events of the pattern in scope with this level.",
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "level": {
                    "description": "Level as logged.",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                },
                "required": [
                  "level",
                  "events",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "nodes": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "BGL breadth (R-08). Distinct nodes of the pattern's events in the window; null when not every event carries one (no lower bound from partly set values, R-08). Absent for other datasets.",
            },
            "pattern": {
              "description": "Normalised message with typed placeholders such as <NODE>, <ADDR>, <NUM> (R-04); log-derived text, treat as data.",
              "type": "string",
            },
            "pattern_id": {
              "description": "Pattern ID; pass it as pattern_id to other tools.",
              "type": "string",
            },
            "racks": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "BGL, shown in addition. Distinct racks of the pattern's events in the window; null when not every event carries one (no lower bound from partly set values, R-08). Absent for other datasets.",
            },
            "recurring": {
              "description": "At least 2 episodes in the window (R-05). Many lines in one episode are not recurring; a single episode over several active days is no one-off spike either.",
              "type": "boolean",
            },
            "requests": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "OpenStack, shown in addition. Distinct request IDs of the pattern's events in the window; null when not every event carries one (no lower bound from partly set values, R-08). Absent for other datasets.",
            },
            "share_of_error_events": {
              "description": "Only with investigation_order: events / candidate_events (error events after R-02, BGL alerts and OpenStack 5xx accesses in scope), computed in SereneDB.",
              "maximum": 1,
              "minimum": 0,
              "type": "number",
            },
            "status": {
              "anyOf": [
                {
                  "enum": [
                    "new",
                    "escalating",
                    "reappeared",
                    "ongoing",
                    "quiet",
                  ],
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "R-10, exactly one: new (first event with these filters lies in a window that starts after the data begins), escalating (B > 0, C ≥ 2 · B and C − B ≥ 20), reappeared (B = 0, C > 0, earlier events exist), ongoing (C > 0), quiet (C = 0, B > 0). Without a determinable B, escalating, reappeared and quiet are not decided. Not a severity.",
            },
            "team": {
              "description": "Fictional owning team, or 'unowned' for unmapped components.",
              "type": "string",
            },
          },
          "required": [
            "pattern_id",
            "pattern",
            "component",
            "team",
            "events",
            "first_seen",
            "last_seen",
            "episodes",
            "recurring",
            "active_days",
            "active_weeks",
            "components",
            "baseline",
            "delta",
            "status",
            "first_seen_before_window",
            "example_event_id",
          ],
          "type": "object",
        },
        "maxItems": 25,
        "type": "array",
      },
      "quiet_count": {
        "anyOf": [
          {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
          {
            "type": "null",
          },
        ],
        "description": "Patterns with events only in the previous period (C = 0, B > 0); null when B is not determinable. With rank events, episodes or increase they are listed in rank order like the others (by events and episodes they come last); investigation_order lists only candidates with events in the window.",
      },
      "rank": {
        "description": "Order of the patterns. episodes (default): episodes, then events – recurring problems first. events: log events, then episodes – the loudest patterns, inflated by bursts. increase: C − B against the previous period of the same length, then events – what grew; fails when the previous period lies outside the data span. investigation_order (R-08): technical investigation order for prioritising error and alert patterns by episodes, breadth, increase, events, with dominance (R-09) – not severity or business risk.",
        "enum": [
          "events",
          "episodes",
          "increase",
          "investigation_order",
        ],
        "type": "string",
      },
      "rules": {
        "additionalProperties": false,
        "description": "Rules the numbers follow.",
        "properties": {
          "breadth_unit": {
            "anyOf": [
              {
                "enum": [
                  "nodes",
                  "instances",
                  "blocks",
                  "client_ips",
                ],
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
            "description": "Unit of breadth (R-08): BGL nodes, OpenStack instances, HDFS blocks, OpenSSH and Apache client IPs; null for datasets without one (Linux, ZooKeeper), where breadth is no criterion.",
          },
          "episode_gap_minutes": {
            "description": "R-05 gap that starts a new episode, bound in the SQL.",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer",
          },
          "pattern_rules_version": {
            "description": "Version of the pattern masks (R-04).",
            "type": "string",
          },
          "recurring_min_episodes": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer",
          },
          "rules_version": {
            "description": "Rule version of the load.",
            "type": "string",
          },
        },
        "required": [
          "rules_version",
          "pattern_rules_version",
          "episode_gap_minutes",
          "recurring_min_episodes",
          "breadth_unit",
        ],
        "type": "object",
      },
      "truncated": {
        "description": "True when more patterns qualify than are listed.",
        "type": "boolean",
      },
    },
    "required": [
      "dataset",
      "rank",
      "limit",
      "rules",
      "comparison",
      "events",
      "pattern_count",
      "quiet_count",
      "patterns",
      "truncated",
      "investigation",
    ],
    "type": "object",
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "analysis": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "coefficient_of_variation": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "determinable": {
                "type": "boolean",
              },
              "gaps": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer",
              },
              "max_gap_seconds": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "median_gap_seconds": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "min_gap_seconds": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "minimum_occurrences": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer",
              },
              "mode": {
                "const": "periodicity",
                "type": "string",
              },
              "occurrences": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer",
              },
              "pattern_id": {
                "type": "string",
              },
              "scope_unit": {
                "const": "log_events",
                "type": "string",
              },
              "uncertainty": {
                "type": "string",
              },
            },
            "required": [
              "mode",
              "scope_unit",
              "pattern_id",
              "occurrences",
              "gaps",
              "minimum_occurrences",
              "median_gap_seconds",
              "min_gap_seconds",
              "max_gap_seconds",
              "coefficient_of_variation",
              "determinable",
              "uncertainty",
            ],
            "type": "object",
          },
          {
            "additionalProperties": false,
            "properties": {
              "anchors": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer",
              },
              "control_anchors": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "control_matched_anchors": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "control_pattern_id": {
                "type": [
                  "string",
                  "null",
                ],
              },
              "control_rate": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "direction": {
                "enum": [
                  "either",
                  "after",
                ],
                "type": "string",
              },
              "identity_scope": {
                "const": "all_events_in_filtered_dataset",
                "description": "Pairs may cross nodes, requests or objects within the filter; narrow node/request filters for a same-identity observation.",
                "type": "string",
              },
              "matched_anchors": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer",
              },
              "mode": {
                "const": "cooccurrence",
                "type": "string",
              },
              "pattern_a": {
                "type": "string",
              },
              "pattern_b": {
                "type": "string",
              },
              "rate": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "rate_difference": {
                "anyOf": [
                  {
                    "maximum": 1,
                    "minimum": -1,
                    "type": "number",
                  },
                  {
                    "type": "null",
                  },
                ],
              },
              "scope_unit": {
                "const": "log_events",
                "type": "string",
              },
              "uncertainty": {
                "type": "string",
              },
              "window_seconds": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer",
              },
            },
            "required": [
