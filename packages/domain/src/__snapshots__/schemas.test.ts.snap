              "maximum": 1,
              "minimum": 0,
              "type": "number",
            },
            "status": {
              "anyOf": [
                {
                  "enum": [
                    "new",
                    "escalating",
                    "reappeared",
                    "ongoing",
                    "quiet",
                  ],
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "R-10, exactly one: new (first event with these filters lies in a window that starts after the data begins), escalating (B > 0, C ≥ 2 · B and C − B ≥ 20), reappeared (B = 0, C > 0, earlier events exist), ongoing (C > 0), quiet (C = 0, B > 0). Without a determinable B, escalating, reappeared and quiet are not decided. Not a severity.",
            },
            "team": {
              "description": "Fictional owning team, or 'unowned' for unmapped components.",
              "type": "string",
            },
          },
          "required": [
            "pattern_id",
            "pattern",
            "component",
            "team",
            "events",
            "first_seen",
            "last_seen",
            "episodes",
            "recurring",
            "active_days",
            "active_weeks",
            "components",
            "baseline",
            "delta",
            "status",
            "first_seen_before_window",
            "example_event_id",
          ],
          "type": "object",
        },
        "maxItems": 25,
        "type": "array",
      },
      "quiet_count": {
        "anyOf": [
          {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
          {
            "type": "null",
          },
        ],
        "description": "Patterns with events only in the previous period (C = 0, B > 0); null when B is not determinable. With rank events, episodes or increase they are listed in rank order like the others (by events and episodes they come last); investigation_order lists only candidates with events in the window.",
      },
      "rank": {
        "description": "Order of the patterns. episodes (default): episodes, then events – recurring problems first. events: log events, then episodes – the loudest patterns, inflated by bursts. increase: C − B against the previous period of the same length, then events – what grew; fails when the previous period lies outside the data span. investigation_order (R-08): technical investigation order for prioritising error and alert patterns by episodes, breadth, increase, events, with dominance (R-09) – not severity or business risk.",
        "enum": [
          "events",
          "episodes",
          "increase",
          "investigation_order",
        ],
        "type": "string",
      },
      "rules": {
        "additionalProperties": false,
        "description": "Rules the numbers follow.",
        "properties": {
          "breadth_unit": {
            "anyOf": [
              {
                "enum": [
                  "nodes",
                  "instances",
                  "blocks",
                  "client_ips",
                ],
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
            "description": "Unit of breadth (R-08): BGL nodes, OpenStack instances, HDFS blocks, OpenSSH and Apache client IPs; null for datasets without one (Linux, ZooKeeper), where breadth is no criterion.",
          },
          "episode_gap_minutes": {
            "description": "R-05 gap that starts a new episode, bound in the SQL.",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer",
          },
          "pattern_rules_version": {
            "description": "Version of the pattern masks (R-04).",
            "type": "string",
          },
          "recurring_min_episodes": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer",
          },
          "rules_version": {
            "description": "Rule version of the load.",
            "type": "string",
          },
        },
        "required": [
          "rules_version",
          "pattern_rules_version",
          "episode_gap_minutes",
          "recurring_min_episodes",
          "breadth_unit",
        ],
        "type": "object",
      },
      "truncated": {
        "description": "True when more patterns qualify than are listed.",
        "type": "boolean",
      },
    },
    "required": [
      "dataset",
      "rank",
      "limit",
      "rules",
      "comparison",
      "events",
      "pattern_count",
      "quiet_count",
      "patterns",
      "truncated",
      "investigation",
    ],
    "type": "object",
  },
}
`;

exports[`JSON Schema export > searchLogsInput converts losslessly for input and output 1`] = `
{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "alert_label": {
        "description": "BGL only: dataset alert label (not our finding), e.g. KERNDTLB.",
        "maxLength": 32,
        "minLength": 1,
        "type": "string",
      },
      "block_id": {
        "description": "HDFS only: exact block ID, e.g. blk_-1608999687919862906.",
        "pattern": "^blk_-?\\d{1,20}$",
        "type": "string",
      },
      "client_ip": {
        "description": "OpenSSH and Apache only: exact IPv4 address of the remote side, e.g. 173.234.31.186.",
        "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}$",
        "type": "string",
      },
      "components": {
        "description": "Only these components (exact names, 1–20). BGL: e.g. KERNEL; OpenStack: e.g. nova-compute; otel: the service, e.g. cart.",
        "items": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array",
      },
      "dataset": {
        "description": "Dataset: bgl (BGL), openstack (OpenStack), hdfs (HDFS_v1), openssh (OpenSSH), apache (Apache), linux (Linux), zookeeper (ZooKeeper), otel (OpenTelemetry logs (text_bench)), otel_replay (OpenTelemetry OTLP replay (text_bench sample)). No two datasets share a time axis; describe_corpus lists the loaded ones. otel and otel_replay are not in log_events and only queried when named here: otel is read in place from remote Parquet files (full text only inside its indexed reference window; counts or trends without text need from/to at most 60 s apart), otel_replay is a bounded OTLP replay of public records into SereneDB's OTel tables.",
        "enum": [
          "bgl",
          "openstack",
          "hdfs",
          "openssh",
          "apache",
          "linux",
          "zookeeper",
          "otel",
          "otel_replay",
        ],
        "type": "string",
      },
      "from": {
        "description": "Window start, inclusive. ISO-8601 with Z or ±HH:MM and at most 6 fractional digits, e.g. 2005-06-03T00:00:00Z. Default: start of the data span.",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string",
      },
      "host": {
        "description": "OpenSSH and Linux only: exact syslog host, e.g. LabSZ, combo.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "instance_id": {
        "description": "OpenStack only: exact instance UUID.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "levels": {
        "description": "Only these levels (1–10).",
        "items": {
          "description": "Level exactly as logged, e.g. INFO, WARNING, ERROR, FATAL (BGL), WARN (HDFS, ZooKeeper), error, notice (Apache), info, information, error (otel).",
          "pattern": "^[A-Za-z][A-Za-z_]{0,15}$",
          "type": "string",
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array",
      },
      "limit": {
        "default": 20,
        "description": "Hits to return (1–50). Default: 20. total_matches is exact regardless.",
        "maximum": 50,
        "minimum": 1,
        "type": "integer",
      },
      "match": {
        "default": "terms",
        "description": "terms (default): every word must occur in the message, in any order. phrase: the words must occur adjacent and in this order, e.g. 'cache parity error'. fuzzy: one term that may contain up to max_edits typos, e.g. 'parrity' finds 'parity'. semantic: cosine vector retrieval from a pinned representation. hybrid: BM25 plus cosine candidates fused with reciprocal rank fusion. Semantic and hybrid require retrieval_snapshot and return bounded candidates, never a frequency.",
        "enum": [
          "terms",
          "phrase",
          "fuzzy",
          "semantic",
          "hybrid",
        ],
        "type": "string",
      },
      "max_edits": {
        "description": "Only with match "fuzzy": edits allowed per term (1–2; insertion, deletion, substitution or swap of two adjacent characters). Default: 1.",
        "maximum": 2,
        "minimum": 1,
        "type": "integer",
      },
      "node": {
        "description": "BGL only: exact node ID, e.g. R02-M1-N0-C:J12-U11.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "only_alerts": {
        "description": "BGL only: only lines with an alert label other than '-'. Default: false.",
        "type": "boolean",
      },
      "only_errors": {
        "description": "Only error events (R-02 levels per dataset). Default: false.",
        "type": "boolean",
      },
      "process_id": {
        "description": "OpenSSH and Linux only: exact process ID as logged, e.g. 24200; IDs repeat over time, so combine with from/to.",
        "pattern": "^\\d{1,10}$",
        "type": "string",
      },
      "query": {
        "description": "Search text (1–200 characters). Lexical modes match case-insensitive whole tokens without stemming; operators, quotes and * are tokenized, not evaluated, and need a searchable word. Semantic/hybrid use the exact text with the pinned embedding model; hybrid additionally tokenizes the text for BM25.",
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
      "rack": {
        "description": "BGL only: rack, e.g. R02.",
        "maxLength": 16,
        "minLength": 1,
        "type": "string",
      },
      "request_id": {
        "description": "OpenStack only: exact request ID, e.g. req-<uuid>.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "retrieval_snapshot": {
        "description": "Immutable representation snapshot ID, required for semantic and hybrid; use a snapshot built with retrieval:build. Pins provider, model, preprocessing and embeddings for reproducible reruns.",
        "pattern": "^[a-f0-9]{64}$",
        "type": "string",
      },
      "sort": {
        "default": "relevance",
        "description": "relevance (default): lexical BM25 or hybrid RRF highest first, semantic cosine distance lowest first. time_asc / time_desc: event time for lexical modes only. Ties are broken by event_id.",
        "enum": [
          "relevance",
          "time_asc",
          "time_desc",
        ],
        "type": "string",
      },
      "teams": {
        "description": "Only components owned by these teams (fictional ownership table, 1–10); unmapped components are 'unowned'.",
        "items": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array",
      },
      "thread": {
        "description": "ZooKeeper only: exact thread name as logged, e.g. SendWorker:188978561024.",
        "maxLength": 128,
        "minLength": 1,
        "type": "string",
      },
      "to": {
        "description": "Window end, exclusive. ISO-8601 with Z or ±HH:MM, later than from. Default: end of the data span.",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string",
      },
    },
