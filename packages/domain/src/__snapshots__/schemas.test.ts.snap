                          },
                          "from": {
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                            "type": "string",
                          },
                          "glob": {
                            "type": "string",
                          },
                          "name": {
                            "type": "string",
                          },
                          "to": {
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                            "type": "string",
                          },
                        },
                        "required": [
                          "name",
                          "glob",
                          "from",
                          "to",
                          "built_at",
                          "build_ms",
                        ],
                        "type": "object",
                      },
                      {
                        "type": "null",
                      },
                    ],
                    "description": "Index snapshot of the reference window (freshness); null for direct scans.",
                  },
                  "kind": {
                    "const": "remote_parquet",
                    "type": "string",
                  },
                  "mapping_version": {
                    "description": "Column mapping of the remote files (load_manifest).",
                    "type": "string",
                  },
                  "path": {
                    "description": "indexed_window: the inverted index over the reference window; direct_scan: read_parquet over the HTTPS files.",
                    "enum": [
                      "indexed_window",
                      "direct_scan",
                    ],
                    "type": "string",
                  },
                  "source_check": {
                    "additionalProperties": false,
                    "description": "Check before the query that every file still matches its pin.",
                    "properties": {
                      "files_checked": {
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991,
                        "type": "integer",
                      },
                      "method": {
                        "const": "read_blob size and last_modified",
                        "type": "string",
                      },
                    },
                    "required": [
                      "method",
                      "files_checked",
                    ],
                    "type": "object",
                  },
                  "window": {
                    "additionalProperties": false,
                    "description": "Queried window [from, to), UTC.",
                    "properties": {
                      "from": {
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                        "type": "string",
                      },
                      "to": {
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                        "type": "string",
                      },
                    },
                    "required": [
                      "from",
                      "to",
                    ],
                    "type": "object",
                  },
                },
                "required": [
                  "dataset",
                  "kind",
                  "path",
                  "window",
                  "files",
                  "mapping_version",
                  "index",
                  "source_check",
                  "bytes_read",
                  "bytes_estimated_from_footer",
                ],
                "type": "object",
              },
              {
                "additionalProperties": false,
                "description": "OTLP replay source of the run (otel_replay).",
                "properties": {
                  "dataset": {
                    "description": "Dataset: bgl (BGL), openstack (OpenStack), hdfs (HDFS_v1), openssh (OpenSSH), apache (Apache), linux (Linux), zookeeper (ZooKeeper), otel (OpenTelemetry logs (text_bench)), otel_replay (OpenTelemetry OTLP replay (text_bench sample)). No two datasets share a time axis; describe_corpus lists the loaded ones. otel and otel_replay are not in log_events and only queried when named here: otel is read in place from remote Parquet files (full text only inside its indexed reference window; counts or trends without text need from/to at most 60 s apart), otel_replay is a bounded OTLP replay of public records into SereneDB's OTel tables.",
                    "enum": [
                      "bgl",
                      "openstack",
                      "hdfs",
                      "openssh",
                      "apache",
                      "linux",
                      "zookeeper",
                      "otel",
                      "otel_replay",
                    ],
                    "type": "string",
                  },
                  "fixture": {
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                      },
                      "sha256": {
                        "type": "string",
                      },
                      "source_url": {
                        "description": "text_bench file the records were selected from.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "path",
                      "sha256",
                      "source_url",
                    ],
                    "type": "object",
                  },
                  "index": {
                    "additionalProperties": false,
                    "properties": {
                      "built_at": {
                        "description": "When the index snapshot was built; later exports are not in it.",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                        "type": "string",
                      },
                      "name": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "name",
                      "built_at",
                    ],
                    "type": "object",
                  },
                  "kind": {
                    "const": "otlp_replay",
                    "type": "string",
                  },
                  "listener_table": {
                    "description": "SereneDB OTel table the listener wrote into.",
                    "type": "string",
                  },
                  "records": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "replay_id": {
                    "description": "ID of the replay this load posted.",
                    "type": "string",
                  },
                  "replayed_at": {
                    "description": "When the fixture was posted; the observed_timestamp of every record.",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string",
                  },
                },
                "required": [
                  "dataset",
                  "kind",
                  "replay_id",
                  "replayed_at",
                  "records",
                  "fixture",
                  "listener_table",
                  "index",
                ],
                "type": "object",
              },
            ],
          },
          "sql": {
            "description": "Exact SQL texts in execution order.",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "truncated": {
            "type": "boolean",
          },
        },
        "required": [
          "receipt_id",
          "input",
          "signature",
          "data_version",
          "sql",
          "params",
          "scope",
          "population",
          "rows_returned",
          "truncated",
          "duration_ms",
          "result_digest",
        ],
        "type": "object",
      },
    },
    "required": [
      "data",
      "facts",
      "receipt",
      "notes",
    ],
    "type": "object",
  },
  "output": {
    "$defs": {
      "__schema0": {
        "anyOf": [
          {
            "type": "string",
          },
          {
            "type": "number",
          },
          {
            "type": "boolean",
          },
          {
            "type": "null",
          },
          {
            "items": {
              "$ref": "#/$defs/__schema0",
            },
            "type": "array",
          },
          {
            "additionalProperties": {
              "$ref": "#/$defs/__schema0",
            },
            "propertyNames": {
              "type": "string",
            },
            "type": "object",
          },
        ],
      },
      "__schema1": {
        "anyOf": [
          {
            "type": "string",
          },
          {
            "type": "number",
          },
          {
            "type": "boolean",
          },
          {
            "type": "null",
          },
          {
            "items": {
              "$ref": "#/$defs/__schema1",
            },
            "type": "array",
          },
          {
            "additionalProperties": {
              "$ref": "#/$defs/__schema1",
            },
            "propertyNames": {
              "type": "string",
            },
            "type": "object",
          },
        ],
      },
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "data": {
        "additionalProperties": false,
        "properties": {
          "total": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
          },
        },
        "required": [
          "total",
        ],
        "type": "object",
      },
      "facts": {
        "description": "Citable facts; quote their IDs, never build paths.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "group": {
              "additionalProperties": {
                "type": "string",
              },
              "description": "Dimension values of the row the value belongs to; {} for ungrouped facts.",
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
            "id": {
              "description": "Fact ID as listed in a tool result's facts, e.g. r_7f3a9c21.f4. Never build it yourself.",
              "pattern": "^r_[0-9a-f]{8}\\.f[1-9][0-9]*$",
              "type": "string",
            },
            "metric": {
              "type": "string",
            },
            "path": {
              "description": "JSON pointer of the value inside the receipt, e.g. /result/groups/2/events.",
              "type": "string",
            },
            "unit": {
              "type": "string",
            },
            "value": {
              "description": "Number, or ISO-8601 instant for times.",
              "type": [
                "number",
                "string",
              ],
            },
          },
          "required": [
            "id",
            "path",
            "value",
            "metric",
            "unit",
            "group",
          ],
          "type": "object",
        },
        "type": "array",
      },
      "notes": {
        "description": "Caveats to carry into the answer.",
        "items": {
          "type": "string",
        },
        "type": "array",
      },
      "receipt": {
        "additionalProperties": false,
        "description": "Receipt summary returned with every result; the full receipt is receipt://{id}.",
        "properties": {
          "data_version": {
            "description": "load_manifest data version the run read.",
            "minLength": 1,
            "type": "string",
          },
          "duration_ms": {
            "description": "Sum of database round trips in milliseconds.",
            "minimum": 0,
            "type": "number",
          },
          "input": {
            "$ref": "#/$defs/__schema0",
            "description": "Validated input with resolved defaults; basis for re-run.",
          },
          "params": {
            "description": "Bound parameters per SQL text.",
            "items": {
              "items": {
                "$ref": "#/$defs/__schema1",
              },
              "type": "array",
            },
            "type": "array",
          },
          "population": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "description": "Events, accesses or requests in scope, or total matches.",
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "unit": {
                    "description": "R-01 counting unit: log_events (parsed lines), api_accesses (OpenStack lines with HTTP status), requests (unique request IDs).",
                    "enum": [
                      "log_events",
                      "api_accesses",
                      "requests",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "count",
                  "unit",
                ],
                "type": "object",
              },
              {
                "type": "null",
              },
            ],
            "description": "Population in scope with its counting unit; null for tools without an exact corpus population (check_claims and bounded semantic/hybrid retrieval).",
          },
          "receipt_id": {
            "description": "Receipt ID: r_ followed by 8 lower-case hex digits, e.g. r_7f3a9c21.",
            "pattern": "^r_[0-9a-f]{8}$",
            "type": "string",
          },
          "result_digest": {
            "description": "SHA-256 over canonical JSON of result.",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string",
          },
          "rows_returned": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
          "scope": {
            "additionalProperties": false,
            "description": "What the numbers cover.",
            "properties": {
              "filters": {
                "additionalProperties": false,
                "description": "Filters applied besides dataset and window.",
                "properties": {
                  "alert_label": {
                    "description": "BGL only: dataset alert label (not our finding), e.g. KERNDTLB.",
                    "maxLength": 32,
                    "minLength": 1,
                    "type": "string",
                  },
                  "block_id": {
                    "description": "HDFS only: exact block ID, e.g. blk_-1608999687919862906.",
                    "pattern": "^blk_-?\\d{1,20}$",
                    "type": "string",
                  },
                  "client_ip": {
                    "description": "OpenSSH and Apache only: exact IPv4 address of the remote side, e.g. 173.234.31.186.",
                    "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}$",
                    "type": "string",
                  },
                  "components": {
                    "description": "Only these components (exact names, 1–20). BGL: e.g. KERNEL; OpenStack: e.g. nova-compute; otel: the service, e.g. cart.",
                    "items": {
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "maxItems": 20,
                    "minItems": 1,
                    "type": "array",
                  },
                  "endpoints": {
                    "description": "OpenStack only: only API accesses to these endpoints (1–20), exactly as returned with IDs masked, e.g. /v2/<ID>/servers/detail.",
                    "items": {
                      "maxLength": 200,
                      "minLength": 1,
                      "type": "string",
                    },
                    "maxItems": 20,
                    "minItems": 1,
                    "type": "array",
                  },
                  "host": {
                    "description": "OpenSSH and Linux only: exact syslog host, e.g. LabSZ, combo.",
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string",
                  },
                  "http_status": {
                    "additionalProperties": false,
                    "description": "OpenStack only: only API accesses whose HTTP status lies in [min, max], both inclusive, e.g. {min: 500, max: 599} for 5xx or {min: 400, max: 499} for 4xx.",
                    "properties": {
                      "max": {
                        "description": "Highest status, inclusive.",
                        "maximum": 599,
                        "minimum": 100,
                        "type": "integer",
                      },
                      "min": {
                        "description": "Lowest status, inclusive.",
                        "maximum": 599,
                        "minimum": 100,
                        "type": "integer",
                      },
                    },
                    "required": [
                      "min",
                      "max",
                    ],
                    "type": "object",
                  },
                  "instance_id": {
                    "description": "OpenStack only: exact instance UUID.",
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string",
                  },
                  "levels": {
                    "description": "Only these levels (1–10).",
                    "items": {
                      "description": "Level exactly as logged, e.g. INFO, WARNING, ERROR, FATAL (BGL), WARN (HDFS, ZooKeeper), error, notice (Apache), info, information, error (otel).",
                      "pattern": "^[A-Za-z][A-Za-z_]{0,15}$",
                      "type": "string",
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "type": "array",
                  },
                  "node": {
                    "description": "BGL only: exact node ID, e.g. R02-M1-N0-C:J12-U11.",
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string",
                  },
                  "only_alerts": {
                    "description": "BGL only: only lines with an alert label other than '-'. Default: false.",
                    "type": "boolean",
                  },
                  "only_errors": {
                    "description": "Only error events (R-02 levels per dataset). Default: false.",
                    "type": "boolean",
                  },
                  "pattern_id": {
                    "description": "Exact pattern ID as returned by recurring_patterns (lower-case hex).",
                    "pattern": "^[0-9a-f]{8,64}$",
                    "type": "string",
                  },
                  "process_id": {
                    "description": "OpenSSH and Linux only: exact process ID as logged, e.g. 24200; IDs repeat over time, so combine with from/to.",
                    "pattern": "^\\d{1,10}$",
                    "type": "string",
                  },
                  "rack": {
                    "description": "BGL only: rack, e.g. R02.",
                    "maxLength": 16,
                    "minLength": 1,
                    "type": "string",
                  },
                  "request_id": {
                    "description": "OpenStack only: exact request ID, e.g. req-<uuid>.",
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string",
                  },
                  "teams": {
                    "description": "Only components owned by these teams (fictional ownership table, 1–10); unmapped components are 'unowned'.",
                    "items": {
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string",
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "type": "array",
                  },
                  "text": {
                    "description": "Full-text condition on the message, all terms must match (1–200 characters).",
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string",
                  },
                  "thread": {
                    "description": "ZooKeeper only: exact thread name as logged, e.g. SendWorker:188978561024.",
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string",
                  },
                  "trace_id": {
                    "description": "otel only: exact OTel TraceId as logged (lower-case hex). Recorded as the scope of get_log_context same_trace.",
                    "pattern": "^[0-9a-f]{1,64}$",
                    "type": "string",
                  },
                },
                "type": "object",
              },
              "windows": {
                "description": "One window per dataset (no two datasets share a time axis), or the two periods of a comparison within one dataset; empty for check_claims, which reads receipts, not the corpus.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "dataset": {
                      "description": "Dataset: bgl (BGL), openstack (OpenStack), hdfs (HDFS_v1), openssh (OpenSSH), apache (Apache), linux (Linux), zookeeper (ZooKeeper), otel (OpenTelemetry logs (text_bench)), otel_replay (OpenTelemetry OTLP replay (text_bench sample)). No two datasets share a time axis; describe_corpus lists the loaded ones. otel and otel_replay are not in log_events and only queried when named here: otel is read in place from remote Parquet files (full text only inside its indexed reference window; counts or trends without text need from/to at most 60 s apart), otel_replay is a bounded OTLP replay of public records into SereneDB's OTel tables.",
                      "enum": [
                        "bgl",
                        "openstack",
                        "hdfs",
                        "openssh",
                        "apache",
                        "linux",
                        "zookeeper",
                        "otel",
                        "otel_replay",
                      ],
                      "type": "string",
                    },
                    "from": {
                      "description": "Resolved window start, inclusive.",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                      "type": "string",
                    },
                    "period": {
                      "description": "Only in period comparisons: current period C or reference period B.",
                      "enum": [
                        "current",
                        "baseline",
                      ],
                      "type": "string",
                    },
                    "to": {
                      "description": "Resolved window end, exclusive.",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                      "type": "string",
                    },
                  },
                  "required": [
                    "dataset",
                    "from",
                    "to",
                  ],
                  "type": "object",
                },
                "maxItems": 9,
                "type": "array",
              },
            },
            "required": [
              "windows",
              "filters",
            ],
            "type": "object",
          },
          "signature": {
            "description": "SHA-256 over canonical JSON of tool, tool_version and input (query identity).",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string",
          },
          "source": {
            "description": "Source of the run; only for datasets outside log_events.",
            "oneOf": [
              {
                "additionalProperties": false,
                "description": "Remote Parquet source of the run (otel).",
                "properties": {
                  "bytes_estimated_from_footer": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "basis": {
                            "type": "string",
                          },
                          "bytes": {
                            "maximum": 9007199254740991,
                            "minimum": 0,
                            "type": "integer",
                          },
                          "kind": {
                            "const": "estimate",
                            "type": "string",
                          },
                          "row_groups": {
                            "maximum": 9007199254740991,
                            "minimum": 0,
