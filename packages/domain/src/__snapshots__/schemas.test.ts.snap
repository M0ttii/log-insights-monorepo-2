                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "unit": {
                    "description": "R-01 counting unit: log_events (parsed lines), api_accesses (OpenStack lines with HTTP status), requests (unique request IDs).",
                    "enum": [
                      "log_events",
                      "api_accesses",
                      "requests",
