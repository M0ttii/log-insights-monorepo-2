            ],
          },
          "anchors": {
            "description": "Episode starts among the matched events (gap ≥ 30 min, order ts, event_id); later events of an episode are no anchors.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer",
          },
          "base_rate_grid": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "description": "Grid start: start of the window, clamped to the data span.",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string",
                  },
                  "to": {
                    "description": "Grid end, exclusive: end of the window, clamped to the data span.",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "type": "string",
                  },
                  "window_minutes": {
                    "description": "Grid window length, equal to the anchor window.",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
                  },
                  "windows": {
                    "description": "Grid windows of window_minutes from \`from\`; the last one may be shorter.",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer",
