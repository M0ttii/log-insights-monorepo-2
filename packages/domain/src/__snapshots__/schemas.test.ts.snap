            "message_truncated",
            "score",
          ],
          "type": "object",
        },
        "maxItems": 50,
        "type": "array",
      },
      "match_mode": {
        "description": "terms (default): every word must occur in the message, in any order. phrase: the words must occur adjacent and in this order, e.g. 'cache parity error'. fuzzy: one term that may contain up to max_edits typos, e.g. 'parrity' finds 'parity'.",
        "enum": [
          "terms",
          "phrase",
          "fuzzy",
