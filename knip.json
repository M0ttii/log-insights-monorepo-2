{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/eslint-config": {
      "ignoreDependencies": ["next"]
    },
    "packages/ui": {},
    "packages/corpus": {
      "entry": ["tests/integration/print-times.ts"]
    },
    "packages/analytics": {
      "entry": [
        "tests/integration/print-facts.ts",
        "tests/integration/print-times.ts",
        "tests/integration/print-context.ts",
        "tests/integration/print-trend.ts",
        "tests/integration/regen-sql-rule-baseline.ts"
      ],
      "ignoreDependencies": ["tsx"]
    },
    "packages/typescript-config": {
      "ignoreUnresolved": ["next"]
    }
  },
  "ignore": ["vendor/**"],
  "ignoreIssues": {
    "packages/ui/src/components/**": ["exports", "types"]
  }
}
