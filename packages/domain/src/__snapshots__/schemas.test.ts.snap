          "description": "Level exactly as logged, e.g. INFO, WARNING, ERROR, FATAL (BGL), WARN (HDFS, ZooKeeper), error, notice (Apache), info, information, error (otel).",
          "pattern": "^[A-Za-z][A-Za-z_]{0,15}$",
          "type": "string",
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array",
      },
      "mode": {
        "description": "event: the surroundings of one event_id (from search_logs). aggregate: precursor analysis over every episode start of a pattern_id or a query (R-11).",
        "enum": [
          "event",
          "aggregate",
        ],
        "type": "string",
      },
      "node": {
        "description": "BGL only: exact node ID, e.g. R02-M1-N0-C:J12-U11.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "only_alerts": {
        "description": "BGL only: only lines with an alert label other than '-'. Default: false.",
        "type": "boolean",
      },
      "only_errors": {
        "description": "Only error events (R-02 levels per dataset). Default: false.",
        "type": "boolean",
      },
      "pattern_id": {
        "description": "Mode aggregate only: anchor pattern, exact pattern_id (lower-case hex) as returned by search results, get_log_context or recurring_patterns. Give pattern_id or query, not both.",
        "pattern": "^[0-9a-f]{8,64}$",
        "type": "string",
      },
      "process_id": {
        "description": "OpenSSH and Linux only: exact process ID as logged, e.g. 24200; IDs repeat over time, so combine with from/to.",
        "pattern": "^\\d{1,10}$",
        "type": "string",
      },
      "query": {
        "description": "Mode aggregate only: anchor search condition (1–200 characters), every word must occur in the message, like search_logs match terms. Give pattern_id or query, not both.",
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
      "rack": {
        "description": "BGL only: rack, e.g. R02.",
        "maxLength": 16,
        "minLength": 1,
        "type": "string",
      },
      "request_id": {
        "description": "OpenStack only: exact request ID, e.g. req-<uuid>.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "scope": {
        "description": "Mode event only: which neighbours to show; the anchor must carry the scope's value. Default: same_node for BGL events with a node, same_block for HDFS, same_process for OpenSSH, same_client for Apache events with a client, otherwise same_component.",
        "enum": [
          "same_node",
          "same_component",
          "same_request",
          "same_block",
          "same_process",
          "same_client",
          "same_thread",
          "same_trace",
          "dataset",
        ],
        "type": "string",
      },
      "teams": {
        "description": "Only components owned by these teams (fictional ownership table, 1–10); unmapped components are 'unowned'.",
        "items": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array",
      },
      "thread": {
        "description": "ZooKeeper only: exact thread name as logged, e.g. SendWorker:188978561024.",
        "maxLength": 128,
        "minLength": 1,
        "type": "string",
      },
      "to": {
        "description": "Window end, exclusive. ISO-8601 with Z or ±HH:MM, later than from. Default: end of the data span.",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string",
      },
      "top_n": {
        "description": "Mode aggregate only: patterns to list per direction (1–20). Default: 10.",
        "maximum": 20,
        "minimum": 1,
        "type": "integer",
      },
      "window_minutes": {
        "default": 10,
        "description": "Both modes: window length w in minutes (1–60). Default: 10.",
        "maximum": 60,
        "minimum": 1,
        "type": "integer",
      },
    },
    "required": [
      "mode",
      "window_minutes",
    ],
    "type": "object",
  },
}
`;

