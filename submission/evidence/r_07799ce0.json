  "sql": [
    "SELECT strftime(first_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS first, strftime(last_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS last FROM corpus_stats WHERE dataset = $1",
    "WITH comparison_bounds AS (SELECT $1::TIMESTAMPTZ AS cf, $2::TIMESTAMPTZ AS ct, $3::TIMESTAMPTZ AS bf, $4::TIMESTAMPTZ AS bt, $5::TIMESTAMPTZ AS first_ts, $6::TIMESTAMPTZ + INTERVAL '1 microsecond' AS end_ts), comparison_coverage AS (SELECT CASE WHEN ct <= first_ts OR cf >= end_ts THEN 'none' WHEN cf >= first_ts AND ct <= end_ts THEN 'full' ELSE 'partial' END AS current, CASE WHEN bt <= first_ts OR bf >= end_ts THEN 'none' WHEN bf >= first_ts AND bt <= end_ts THEN 'full' ELSE 'partial' END AS baseline FROM comparison_bounds) SELECT current, baseline, current <> 'none' AND baseline <> 'none' AS determinable FROM comparison_coverage",
    "WITH grouped AS (SELECT coalesce((SELECT o.team FROM ownership o WHERE o.dataset = log_events.dataset AND o.component = log_events.component), 'unowned') AS g1, count(*) FILTER (WHERE log_events.ts >= $2::TIMESTAMPTZ AND log_events.ts < $3::TIMESTAMPTZ) AS events, count(*) FILTER (WHERE log_events.ts >= $4::TIMESTAMPTZ AND log_events.ts < $5::TIMESTAMPTZ) AS baseline FROM log_events WHERE log_events.dataset = $1 AND log_events.is_error AND ((log_events.ts >= $2::TIMESTAMPTZ AND log_events.ts < $3::TIMESTAMPTZ) OR (log_events.ts >= $4::TIMESTAMPTZ AND log_events.ts < $5::TIMESTAMPTZ)) GROUP BY 1), ranked AS (SELECT g1, events, baseline, row_number() OVER (ORDER BY abs(events - baseline) DESC, events DESC, g1 ASC NULLS LAST) AS rank, sum(events) OVER () AS total FROM grouped), summary AS (SELECT coalesce(sum(events), 0) AS c, sum(baseline) AS b, count(*) AS n, count(*) FILTER (WHERE rank > $6) AS other_n, coalesce(sum(events) FILTER (WHERE rank > $6), 0) AS other_c, sum(baseline) FILTER (WHERE rank > $6) AS other_b FROM ranked) SELECT 0::BIGINT AS rank, NULL AS g1, c::BIGINT AS events, NULL::DOUBLE AS share, coalesce(b, 0)::BIGINT AS baseline, (c - coalesce(b, 0))::BIGINT AS delta, 100 * (c - coalesce(b, 0))::DOUBLE / NULLIF(coalesce(b, 0), 0) AS pct_change, CASE WHEN coalesce(b, 0) IS NULL THEN NULL WHEN coalesce(b, 0) = 0 AND c > 0 THEN 'first observed in this comparison' WHEN coalesce(b, 0) = 0 THEN 'not observed in either period' WHEN c >= $7::BIGINT * coalesce(b, 0) AND c - coalesce(b, 0) >= $8::BIGINT THEN 'significantly increased' END AS classification, n::BIGINT AS group_count, other_n::BIGINT AS other_groups, other_c::BIGINT AS other_events, other_c::DOUBLE / NULLIF(c, 0) AS other_share, coalesce(other_b, 0)::BIGINT AS other_baseline, (other_c - coalesce(other_b, 0))::BIGINT AS other_delta, 100 * (other_c - coalesce(other_b, 0))::DOUBLE / NULLIF(coalesce(other_b, 0), 0) AS other_pct_change FROM summary UNION ALL SELECT rank, g1, events, events::DOUBLE / NULLIF(total, 0), baseline::BIGINT AS baseline, (events - baseline)::BIGINT AS delta, 100 * (events - baseline)::DOUBLE / NULLIF(baseline, 0) AS pct_change, CASE WHEN baseline IS NULL THEN NULL WHEN baseline = 0 AND events > 0 THEN 'first observed in this comparison' WHEN baseline = 0 THEN 'not observed in either period' WHEN events >= $7::BIGINT * baseline AND events - baseline >= $8::BIGINT THEN 'significantly increased' END AS classification, NULL, NULL, NULL, NULL, NULL, NULL, NULL FROM ranked WHERE rank <= $6 ORDER BY rank"
