{
  "name": "log-insights-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "oxlint --deny-warnings && turbo lint",
    "lint:fix": "oxlint --fix && turbo lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css}\"",
    "typecheck": "turbo typecheck",
    "test": "vitest run --project packages",
    "test:integration": "vitest run --project corpus-integration --project analytics-integration --no-file-parallelism",
    "test:watch": "vitest --project packages",
    "deps:check": "depcruise apps packages --config .dependency-cruiser.cjs",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm deps:check && pnpm knip && pnpm test",
    "gate": "pnpm --filter @workspace/corpus gate",
    "data:setup": "pnpm --filter @workspace/corpus data:setup",
    "data:profile": "pnpm --filter @workspace/corpus data:profile",
    "mcp": "pnpm --silent --dir apps/mcp start",
    "mcp:desktop-config": "pnpm --silent --dir apps/mcp run desktop-config",
    "test:mcp": "pnpm --filter @workspace/mcp test:smoke"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "dependency-cruiser": "^18.6.0",
    "knip": "^6.41.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
