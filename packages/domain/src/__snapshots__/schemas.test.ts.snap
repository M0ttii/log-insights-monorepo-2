exports[`JSON Schema export > countEventsOutput converts losslessly for input and output 1`] = `
{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "comparison": {
        "anyOf": [
          {
            "additionalProperties": false,
            "description": "Totals of the comparison: B, C − B, change and R-06 classification of total (= C).",
            "properties": {
              "baseline": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Only with compare: count B in the reference period; null when the comparison is not determinable.",
              },
              "classification": {
                "anyOf": [
                  {
                    "enum": [
                      "first observed in this comparison",
                      "not observed in either period",
                      "significantly increased",
                    ],
                    "type": "string",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Only with compare, R-06: 'first observed in this comparison' (B = 0, C > 0), 'not observed in either period' (C = B = 0), 'significantly increased' (B > 0, C ≥ 2 · B and C − B ≥ 20); null when none applies or not determinable.",
              },
              "coverage": {
                "additionalProperties": false,
                "description": "Data-span coverage of both periods (R-03).",
                "properties": {
                  "baseline": {
                    "description": "Share of the period inside the dataset's data span: full, partial (only the observed part is counted) or none (no observed count).",
                    "enum": [
                      "full",
                      "partial",
                      "none",
                    ],
                    "type": "string",
                  },
                  "current": {
                    "description": "Share of the period inside the dataset's data span: full, partial (only the observed part is counted) or none (no observed count).",
                    "enum": [
                      "full",
                      "partial",
                      "none",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "current",
                  "baseline",
                ],
                "type": "object",
              },
              "delta": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer",
                  },
                  {
                    "type": "null",
                  },
                ],
                "description": "Only with compare: C − B; null when not determinable.",
              },
              "determinable": {
                "description": "False when a period lies entirely outside the data span: then B, delta, pct_change and classification are null everywhere, never 0.",
                "type": "boolean",
              },
              "pct_change": {
                "description": "Only with compare: 100 · (C − B) / B in percent, computed in SereneDB; null when B = 0 or not determinable.",
                "type": [
                  "number",
                  "null",
                ],
              },
              "reference": {
                "description": "previous_period or a chosen reference; both windows are in scope.windows with period current and baseline.",
                "enum": [
                  "previous_period",
                  "custom",
                ],
                "type": "string",
              },
            },
            "required": [
              "reference",
              "coverage",
              "determinable",
              "classification",
            ],
            "type": "object",
          },
          {
            "type": "null",
          },
        ],
        "description": "Period comparison; null without compare.",
      },
      "group_by": {
        "description": "The grouping dimensions, in this order.",
        "items": {
          "description": "Grouping dimension.",
          "enum": [
            "dataset",
            "team",
            "component",
            "level",
            "alert_label",
            "rack",
            "node",
            "pattern",
            "http_status",
            "endpoint",
          ],
          "type": "string",
        },
        "type": "array",
      },
      "group_count": {
        "description": "Number of distinct groups in scope; with compare in either period.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer",
      },
      "groups": {
        "description": "At most top_n groups: events descending, then the dimension values ascending with null last. With a determinable compare: |C − B| descending, then C descending, then the value.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "alert_label": {
              "description": "BGL dataset alert label (not our finding); null = no label.",
              "type": [
                "string",
                "null",
              ],
            },
            "baseline": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "Only with compare: count B in the reference period; null when the comparison is not determinable.",
            },
            "classification": {
              "anyOf": [
                {
                  "enum": [
                    "first observed in this comparison",
                    "not observed in either period",
                    "significantly increased",
                  ],
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "description": "Only with compare, R-06: 'first observed in this comparison' (B = 0, C > 0), 'not observed in either period' (C = B = 0), 'significantly increased' (B > 0, C ≥ 2 · B and C − B ≥ 20); null when none applies or not determinable.",
            },
            "component": {
              "description": "Component or OpenStack service.",
              "type": [
                "string",
                "null",
              ],
            },
            "dataset": {
              "description": "Dataset: bgl (BlueGene/L, 2005–2006) or openstack (2017). They share no time axis.",
              "enum": [
                "bgl",
                "openstack",
              ],
              "type": "string",
            },
            "delta": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "Only with compare: C − B; null when not determinable.",
            },
            "endpoint": {
              "description": "API path with IDs masked.",
              "type": [
                "string",
                "null",
              ],
            },
            "events": {
              "description": "Count of the group in the counting unit; with compare the count C in [from, to).",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "http_status": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "HTTP status of the API accesses.",
            },
            "level": {
              "description": "Level as logged.",
              "type": [
                "string",
                "null",
              ],
            },
            "node": {
              "description": "BGL node; null for events without a node and for OpenStack.",
              "type": [
                "string",
                "null",
              ],
            },
            "pattern": {
              "description": "pattern_id; pass it as pattern_id filter, recurring_patterns shows the pattern text.",
              "type": [
                "string",
                "null",
              ],
            },
            "pct_change": {
              "description": "Only with compare: 100 · (C − B) / B in percent, computed in SereneDB; null when B = 0 or not determinable.",
              "type": [
                "number",
                "null",
              ],
            },
            "rack": {
              "description": "BGL rack; null for events without a node.",
              "type": [
                "string",
                "null",
              ],
            },
