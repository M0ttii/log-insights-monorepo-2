{
  "name": "@workspace/corpus",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "gate": "node --env-file-if-exists=../../.env --import tsx gate/run.ts",
    "data:setup": "node --env-file-if-exists=../../.env --import tsx src/setup.ts",
    "data:container": "node --import tsx src/container-setup.ts",
    "data:profile": "node --env-file-if-exists=../../.env --import tsx src/profile.ts",
    "otel:replay-fixture": "node --env-file-if-exists=../../.env --import tsx src/replay-fixture.ts"
  },
  "dependencies": {
    "@workspace/domain": "workspace:*",
    "pg": "8.23.1",
    "tar": "7.5.22",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
