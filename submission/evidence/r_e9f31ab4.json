  "sql": [
    "SELECT log_events.event_id, strftime(log_events.ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS ts, log_events.component, log_events.level, log_events.node, log_events.alert_label, log_events.request_id, log_events.host, log_events.process_id, log_events.client_ip, log_events.thread, log_events.block_id, log_events.pattern_id, left(log_events.message, 400) AS message, length(log_events.message) > 400 AS message_truncated, log_events.dataset FROM log_events WHERE log_events.event_id = $1",
    "SELECT count(*) FILTER (WHERE log_events.ts >= $1::TIMESTAMPTZ - $3::INTERVAL AND (log_events.ts < $1::TIMESTAMPTZ OR (log_events.ts = $1::TIMESTAMPTZ AND log_events.event_id < $2))) AS before, count(*) FILTER (WHERE log_events.ts <= $1::TIMESTAMPTZ + $3::INTERVAL AND (log_events.ts > $1::TIMESTAMPTZ OR (log_events.ts = $1::TIMESTAMPTZ AND log_events.event_id > $2))) AS after FROM log_events WHERE log_events.dataset = $4 AND log_events.request_id = $5 AND ((log_events.ts >= $1::TIMESTAMPTZ - $3::INTERVAL AND (log_events.ts < $1::TIMESTAMPTZ OR (log_events.ts = $1::TIMESTAMPTZ AND log_events.event_id < $2))) OR (log_events.ts <= $1::TIMESTAMPTZ + $3::INTERVAL AND (log_events.ts > $1::TIMESTAMPTZ OR (log_events.ts = $1::TIMESTAMPTZ AND log_events.event_id > $2))))",
    "SELECT log_events.event_id, strftime(log_events.ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS ts, log_events.component, log_events.level, log_events.node, log_events.alert_label, log_events.request_id, log_events.host, log_events.process_id, log_events.client_ip, log_events.thread, log_events.block_id, log_events.pattern_id, left(log_events.message, 400) AS message, length(log_events.message) > 400 AS message_truncated, (epoch_us(log_events.ts) - epoch_us($1::TIMESTAMPTZ))::DOUBLE / 1000 AS offset_ms FROM log_events WHERE log_events.dataset = $4 AND log_events.request_id = $5 AND log_events.ts >= $1::TIMESTAMPTZ - $3::INTERVAL AND (log_events.ts < $1::TIMESTAMPTZ OR (log_events.ts = $1::TIMESTAMPTZ AND log_events.event_id < $2)) ORDER BY log_events.ts DESC, log_events.event_id DESC LIMIT $6",
    "SELECT log_events.event_id, strftime(log_events.ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS ts, log_events.component, log_events.level, log_events.node, log_events.alert_label, log_events.request_id, log_events.host, log_events.process_id, log_events.client_ip, log_events.thread, log_events.block_id, log_events.pattern_id, left(log_events.message, 400) AS message, length(log_events.message) > 400 AS message_truncated, (epoch_us(log_events.ts) - epoch_us($1::TIMESTAMPTZ))::DOUBLE / 1000 AS offset_ms FROM log_events WHERE log_events.dataset = $4 AND log_events.request_id = $5 AND log_events.ts <= $1::TIMESTAMPTZ + $3::INTERVAL AND (log_events.ts > $1::TIMESTAMPTZ OR (log_events.ts = $1::TIMESTAMPTZ AND log_events.event_id > $2)) ORDER BY log_events.ts, log_events.event_id LIMIT $6"
