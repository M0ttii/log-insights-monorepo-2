        "description": "Number of buckets returned.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer",
      },
      "buckets": {
        "description": "Every bucket of the effective range by bucket_start.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "bucket_end": {
              "description": "Bucket end, UTC, exclusive.",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string",
            },
            "bucket_start": {
              "description": "Bucket start, UTC, inclusive.",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string",
            },
            "capture_gap": {
              "description": "The dataset has no event at all in this bucket (any filter): no data was captured, so its zero is not observed calm.",
              "type": "boolean",
            },
            "events": {
              "description": "Log events in scope in this bucket, all series.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer",
            },
            "other_events": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                {
                  "type": "null",
                },
              ],
              "description": "Events of all other values in this bucket; null when there is no other series.",
            },
            "partial": {
              "description": "The window or the data span starts or ends inside this bucket, so it covers less than a full unit; a lower count here is no drop.",
              "type": "boolean",
            },
            "series": {
              "description": "Events per series in this bucket, in the order of series.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "alert_label": {
                    "description": "Value of alert_label when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "block_id": {
                    "description": "Value of block_id when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "client_ip": {
                    "description": "Value of client_ip when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "component": {
                    "description": "Value of component when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "events": {
                    "description": "Log events of this series.",
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer",
                  },
                  "host": {
                    "description": "Value of host when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "level": {
                    "description": "Value of level when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "node": {
                    "description": "Value of node when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "pattern": {
                    "description": "Value of pattern when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "rack": {
                    "description": "Value of rack when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "team": {
                    "description": "Value of team when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                  "thread": {
                    "description": "Value of thread when the trend is split by it; null is its own category (field empty, e.g. no alert label).",
                    "type": [
                      "string",
                      "null",
                    ],
                  },
                },
                "required": [
                  "events",
                ],
                "type": "object",
              },
              "maxItems": 5,
              "type": "array",
            },
          },
          "required": [
            "bucket_start",
            "bucket_end",
            "partial",
            "capture_gap",
            "events",
            "series",
            "other_events",
          ],
          "type": "object",
        },
        "maxItems": 120,
        "type": "array",
      },
      "data_span": {
        "additionalProperties": false,
        "description": "Observed span of the whole dataset, before any filter.",
        "properties": {
          "first": {
            "description": "First event of the dataset, UTC.",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string",
          },
          "last": {
            "description": "Last event of the dataset, UTC.",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string",
          },
        },
        "required": [
          "first",
          "last",
        ],
        "type": "object",
      },
      "dataset": {
        "description": "Dataset: bgl (BGL), openstack (OpenStack), hdfs (HDFS_v1), openssh (OpenSSH), apache (Apache), linux (Linux), zookeeper (ZooKeeper), otel (OpenTelemetry logs (text_bench)), otel_replay (OpenTelemetry OTLP replay (text_bench sample)). No two datasets share a time axis; describe_corpus lists the loaded ones. otel and otel_replay are not in log_events and only queried when named here: otel is read in place from remote Parquet files (full text only inside its indexed reference window; counts or trends without text need from/to at most 60 s apart), otel_replay is a bounded OTLP replay of public records into SereneDB's OTel tables.",
        "enum": [
          "bgl",
          "openstack",
          "hdfs",
          "openssh",
          "apache",
