              },
            ],
            "description": "Population in scope with its counting unit; null for tools without a corpus population (check_claims).",
          },
          "receipt_id": {
            "description": "Receipt ID: r_ followed by 8 lower-case hex digits, e.g. r_7f3a9c21.",
