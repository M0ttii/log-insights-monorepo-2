exports[`JSON Schema export > recurringPatternsInput converts losslessly for input and output 1`] = `
{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "alert_label": {
        "description": "BGL only: dataset alert label (not our finding), e.g. KERNDTLB.",
        "maxLength": 32,
        "minLength": 1,
        "type": "string",
      },
      "analysis": {
        "description": "Optional temporal observation over the identical filtered dataset/window. cooccurrence counts anchors with a distinct matching event in the window, either direction or strictly after; the comparison is the control pattern's anchor rate, never causal proof. periodicity analyses consecutive occurrence gaps and requires the stated minimum.",
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "min_occurrences": {
                "default": 4,
                "maximum": 10000,
                "minimum": 4,
                "type": "integer",
              },
              "mode": {
                "const": "periodicity",
                "type": "string",
              },
              "pattern_id": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "mode",
              "pattern_id",
            ],
            "type": "object",
          },
          {
            "additionalProperties": false,
            "properties": {
              "control_pattern_id": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string",
              },
              "direction": {
                "default": "either",
                "enum": [
                  "either",
                  "after",
                ],
                "type": "string",
              },
              "mode": {
                "const": "cooccurrence",
                "type": "string",
              },
              "pattern_a": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string",
              },
              "pattern_b": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string",
              },
              "window_seconds": {
                "default": 60,
                "maximum": 3600,
                "minimum": 1,
                "type": "integer",
              },
            },
            "required": [
              "mode",
              "pattern_a",
              "pattern_b",
            ],
            "type": "object",
          },
        ],
      },
      "block_id": {
        "description": "HDFS only: exact block ID, e.g. blk_-1608999687919862906.",
        "pattern": "^blk_-?\\d{1,20}$",
        "type": "string",
      },
      "client_ip": {
        "description": "OpenSSH and Apache only: exact IPv4 address of the remote side, e.g. 173.234.31.186.",
        "pattern": "^\\d{1,3}(?:\\.\\d{1,3}){3}$",
        "type": "string",
      },
      "components": {
        "description": "Only these components (exact names, 1–20). BGL: e.g. KERNEL; OpenStack: e.g. nova-compute; otel: the service, e.g. cart.",
        "items": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array",
      },
      "dataset": {
        "description": "Required, exactly one dataset; describe_corpus lists the loaded ones.",
        "enum": [
          "bgl",
          "openstack",
          "hdfs",
          "openssh",
          "apache",
          "linux",
          "zookeeper",
          "otel",
          "otel_replay",
        ],
        "type": "string",
      },
      "from": {
        "description": "Window start, inclusive. ISO-8601 with Z or ±HH:MM and at most 6 fractional digits, e.g. 2005-06-03T00:00:00Z. Default: start of the data span.",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string",
      },
      "host": {
        "description": "OpenSSH and Linux only: exact syslog host, e.g. LabSZ, combo.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "instance_id": {
        "description": "OpenStack only: exact instance UUID.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "levels": {
        "description": "Only these levels (1–10).",
        "items": {
          "description": "Level exactly as logged, e.g. INFO, WARNING, ERROR, FATAL (BGL), WARN (HDFS, ZooKeeper), error, notice (Apache), info, information, error (otel).",
          "pattern": "^[A-Za-z][A-Za-z_]{0,15}$",
          "type": "string",
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array",
      },
      "limit": {
        "description": "Patterns to return (1–25). Default: 10. With rank investigation_order 1–5, default 3. The resolved value is limit in the result.",
        "maximum": 25,
        "minimum": 1,
        "type": "integer",
      },
      "node": {
        "description": "BGL only: exact node ID, e.g. R02-M1-N0-C:J12-U11.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "only_alerts": {
        "description": "BGL only: only lines with an alert label other than '-'. Default: false.",
        "type": "boolean",
      },
      "only_errors": {
        "description": "Only error events (R-02 levels per dataset). Default: false.",
        "type": "boolean",
      },
      "pattern_id": {
        "description": "Exact pattern ID as returned by recurring_patterns (lower-case hex).",
        "pattern": "^[0-9a-f]{8,64}$",
        "type": "string",
      },
      "process_id": {
        "description": "OpenSSH and Linux only: exact process ID as logged, e.g. 24200; IDs repeat over time, so combine with from/to.",
        "pattern": "^\\d{1,10}$",
        "type": "string",
      },
      "rack": {
        "description": "BGL only: rack, e.g. R02.",
        "maxLength": 16,
        "minLength": 1,
        "type": "string",
      },
      "rank": {
        "default": "episodes",
        "description": "Order of the patterns. episodes (default): episodes, then events – recurring problems first. events: log events, then episodes – the loudest patterns, inflated by bursts. increase: C − B against the previous period of the same length, then events – what grew; fails when the previous period lies outside the data span. investigation_order (R-08): technical investigation order for prioritising error and alert patterns by episodes, breadth, increase, events, with dominance (R-09) – not severity or business risk.",
        "enum": [
          "events",
          "episodes",
          "increase",
          "investigation_order",
        ],
        "type": "string",
      },
      "request_id": {
        "description": "OpenStack only: exact request ID, e.g. req-<uuid>.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string",
      },
      "teams": {
        "description": "Only components owned by these teams (fictional ownership table, 1–10); unmapped components are 'unowned'.",
        "items": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array",
      },
      "text": {
        "description": "Full-text condition on the message, all terms must match (1–200 characters).",
        "maxLength": 200,
        "minLength": 1,
        "type": "string",
      },
      "thread": {
        "description": "ZooKeeper only: exact thread name as logged, e.g. SendWorker:188978561024.",
        "maxLength": 128,
        "minLength": 1,
        "type": "string",
      },
      "to": {
        "description": "Window end, exclusive. ISO-8601 with Z or ±HH:MM, later than from. Default: end of the data span.",
        "format": "date-time",
