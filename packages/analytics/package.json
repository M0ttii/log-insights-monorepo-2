{
  "name": "@workspace/analytics",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "report:perf": "node --env-file-if-exists=../../.env --import tsx src/report-perf.ts",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:golden": "vitest run --config ../../vitest.config.ts --project analytics-golden --no-file-parallelism",
    "otel:measure": "node --env-file-if-exists=../../.env --import tsx src/otel-measure.ts"
  },
  "exports": {
    "./config": "./src/config.ts",
    "./db": "./src/db.ts",
    "./receipts": "./src/receipts.ts",
    "./registry": "./src/registry.ts",
    "./resources": "./src/resources.ts"
  },
  "dependencies": {
    "@workspace/domain": "workspace:*",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
