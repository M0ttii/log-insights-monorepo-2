  "sql": [
    "SELECT ts_lexize('log_text', $1::VARCHAR) AS tokens",
    "SELECT strftime(first_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS first, strftime(last_ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS last FROM corpus_stats WHERE dataset = $1",
    "SELECT count(*) AS total FROM log_events_idx WHERE log_events_idx.message @@ ts_levenshtein($1::VARCHAR, $2::INTEGER) AND log_events_idx.dataset = $3",
    "WITH hits AS MATERIALIZED (SELECT log_events_idx.event_id, log_events_idx.dataset, strftime(log_events_idx.ts, '%Y-%m-%dT%H:%M:%S.%fZ') AS ts, log_events_idx.component, log_events_idx.level, log_events_idx.node, log_events_idx.alert_label, log_events_idx.request_id, left(log_events_idx.message, 400) AS message, length(log_events_idx.message) > 400 AS message_truncated, BM25(log_events_idx.tableoid) AS score FROM log_events_idx WHERE log_events_idx.message @@ ts_levenshtein($1::VARCHAR, $2::INTEGER) AND log_events_idx.dataset = $3 ORDER BY BM25(log_events_idx.tableoid) DESC, log_events_idx.event_id LIMIT $4) SELECT hits.*, matches.match_offsets FROM hits JOIN (SELECT log_events_idx.event_id, ts_offsets(log_events_idx.message) AS match_offsets FROM log_events_idx WHERE log_events_idx.message @@ ts_levenshtein($1::VARCHAR, $2::INTEGER) AND CASE WHEN log_events_idx.event_id IN (SELECT event_id FROM hits) THEN TRUE ELSE FALSE END) AS matches ON hits.event_id = matches.event_id ORDER BY hits.score DESC, hits.event_id"
  ],
